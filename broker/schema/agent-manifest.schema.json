{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://likay-os.dev/schemas/agent-manifest-v1.json",
  "title": "Likay-OS agent manifest",
  "description": "Ver docs/AGENT_INTERFACE.md -- este schema es la fuente de verdad del formato, el documento es prosa y razones.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "agent", "capabilities"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
          "description": "Estilo reverse-DNS, p.ej. com.likay.kal-in"
        },
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "minLength": 1, "maxLength": 50},
        "vendor": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "disk.read",
          "disk.write",
          "partition.manage",
          "bootloader.install",
          "filesystem.data_dir",
          "filesystem.read_external",
          "network.egress",
          "llm.local",
          "gpu.compute",
          "audio.microphone",
          "audio.speaker",
          "camera",
          "clipboard",
          "docker.sandbox"
        ]
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime": {"enum": ["python-venv"]},
        "entry_point": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "requirements_file": {
          "type": "string",
          "minLength": 1,
          "not": {"pattern": "(^/|\\.\\.|^~)"},
          "description": "Un solo archivo, ruta relativa dentro de src/ del bundle. Nunca absoluta, nunca con '..'."
        },
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "health_check_path": {"type": "string", "minLength": 1},
        "env": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filesystem": {
          "enum": ["restricted", "none"],
          "description": "'full' no es un valor legal en v1 -- ver docs/AGENT_INTERFACE.md invariante 10."
        },
        "network": {
          "enum": ["none", "host-egress"]
        },
        "devices": {
          "enum": ["none", "explicit"]
        },
        "device_allow": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Solo tiene efecto si devices == explicit."
        },
        "memory_max": {"type": "string", "pattern": "^[0-9]+[KMGT]?$"},
        "cpu_quota": {"type": "string", "pattern": "^[0-9]+%$"},
        "tasks_max": {"type": "integer", "minimum": 1}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_prefix": {"type": "string", "minLength": 1}
      }
    }
  }
}
