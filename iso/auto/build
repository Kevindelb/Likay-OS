#!/bin/bash
# A diferencia del auto/build de plantilla de live-build (un simple
# passthrough a `lb build`), este hace dos cosas antes/después:
#
#   1. ANTES: siembra config/includes.chroot con lo que `lb build` no
#      puede generar solo — el código de kal (vendor/kal, un submódulo,
#      no algo que viva en el chroot de por sí) y los blobs de Ollama que
#      ya estén en cache de una corrida anterior (model-cache/, vía
#      hardlinks — instantáneo, sin red).
#   2. DESPUÉS: sincroniza de vuelta a model-cache/ cualquier blob que el
#      hook 0200-pull-ollama-model.hook.chroot haya tenido que bajar de
#      verdad (cache frío o modelo nuevo) — así la
#      PRÓXIMA build, aunque sea con `lb clean --chroot` de por medio,
#      no vuelve a pagar esa descarga. Corre pase lo que pase (incluso si
#      `lb build` falla en un stage posterior al de chroot), porque para
#      entonces el pull ya pasó y no tiene sentido tirar ese trabajo.
set -euo pipefail
shopt -s inherit_errexit

cd "$(dirname "${0}")/.."  # iso/

# shellcheck disable=SC1091
source config/likay/model.conf  # define MODEL_TAG (no se usa acá directo,
                                 # pero documenta qué se está horneando)

# Único punto de decisión de la variante del build (pedido explícito
# del usuario, 2026-09-16): todo lo que depende de si kal-in va horneado
# o no se decide ACÁ, una sola vez, y se propaga hacia abajo -- nunca un
# segundo lugar que decida por su cuenta. Se propaga de dos formas:
#   1. Dentro de ESTE script: el bloque de abajo que copia vendor/kal-in
#      a includes.chroot/opt/kal-in se salta entero si es bare -- así
#      que /opt/kal-in simplemente NO EXISTE dentro del chroot. Los
#      hooks que dependen de kal-in (0320-install-kal-in.chroot,
#      0400-setup-kiosk.chroot) no vuelven a preguntar por
#      LIKAY_BARE_KAL_IN -- preguntan si /opt/kal-in existe, que es la
#      consecuencia mecánica de ESTA decisión, no una segunda decisión
#      independiente.
#   2. Entre invocaciones separadas (auto/build acá, y
#      scripts/rebuild-iso-with-fixes.sh como paso manual aparte, ver el
#      comentario al final de este archivo): se persiste en
#      .likay-build-variant para que el nombre del .iso final no dependa
#      de que el usuario recuerde repetir la misma variable a mano en el
#      segundo comando.
LIKAY_BARE_KAL_IN="${LIKAY_BARE_KAL_IN:-0}"
if [ "${LIKAY_BARE_KAL_IN}" = "1" ]; then
    LIKAY_BUILD_VARIANT="bare"
else
    LIKAY_BUILD_VARIANT="default"
fi
echo "=================================================================="
echo "Likay-OS build"
if [ "${LIKAY_BUILD_VARIANT}" = "bare" ]; then
    echo "Variant: bare (no kal-in)"
else
    echo "Variant: default (kal-in baked)"
fi
echo "=================================================================="
echo "${LIKAY_BUILD_VARIANT}" > .likay-build-variant

REPO_ROOT="$(cd .. && pwd)"
MODEL_CACHE_DIR="model-cache"
CHROOT_MODELS_DIR="chroot/usr/share/ollama/.ollama/models"
INCLUDES_MODELS_DIR="config/includes.chroot/usr/share/ollama/.ollama/models"
INCLUDES_KAL_DIR="config/includes.chroot/opt/kal"
INCLUDES_KAL_IN_DIR="config/includes.chroot/opt/kal-in"

echo "==> Copiando vendor/kal a includes.chroot/opt/kal"
mkdir -p "${INCLUDES_KAL_DIR}"
rsync -a --delete \
    --exclude='.git' \
    --exclude='tests' \
    --exclude='vscode-extension' \
    "${REPO_ROOT}/vendor/kal/" "${INCLUDES_KAL_DIR}/"

# vendor/kal-in: prototipo de validación del pipeline de boot (issue
# #2, Fase 1 — kal-in a mano). Ningún agente va horneado en el diseño
# final: el usuario lo instala aparte, en Etapa 2 (ver docs/ROADMAP.md,
# decisión 2026-09-14) — esto sigue en el build solo para probar
# kernel→LLM→agente→kiosco de punta a punta mientras esa etapa no
# existe. Kal-in todavía trae su propio kernel/agent_core/frontend
# completos (la separación de código adentro de kal-in en sí es trabajo
# futuro, según su propio README) — corre standalone, no depende de
# vendor/kal para nada todavía.
if [ "${LIKAY_BUILD_VARIANT}" = "bare" ]; then
    echo "==> Variante bare: saltando vendor/kal-in (no va horneado)"
    rm -rf "${INCLUDES_KAL_IN_DIR}"
    # chroot/ se conserva entre builds a propósito (ver el comentario
    # grande más abajo sobre .build/) -- pero eso significa que si ESTE
    # mismo chroot/ ya tuvo un build "default" antes, /opt/kal-in y el
    # symlink de [Install] de kal-in-backend.service siguen ahí:
    # lb_chroot_includes copia lo que encuentra en includes.chroot/, no
    # borra lo que un build anterior dejó y ya no está. Sin este
    # borrado explícito, hook 0320/0400 verían /opt/kal-in igual y esta
    # build "bare" no sería bare de verdad.
    if [ -d chroot/opt/kal-in ] || [ -d chroot/opt/kal-in-home ] \
       || [ -e chroot/etc/systemd/system/multi-user.target.wants/kal-in-backend.service ]; then
        echo "==> Variante bare: limpiando /opt/kal-in de un build anterior en este mismo chroot/"
        rm -rf chroot/opt/kal-in chroot/opt/kal-in-home
        rm -f chroot/etc/systemd/system/multi-user.target.wants/kal-in-backend.service
    fi
else
    echo "==> Copiando vendor/kal-in a includes.chroot/opt/kal-in"
    mkdir -p "${INCLUDES_KAL_IN_DIR}"
    rsync -a --delete \
        --exclude='.git' \
        --exclude='tests' \
        --exclude='vscode-extension' \
        "${REPO_ROOT}/vendor/kal-in/" "${INCLUDES_KAL_IN_DIR}/"
fi

# vendor/calamares-settings-debian: base vendorizada para el instalador
# de Etapa 2 (config oficial del Debian Live Team para imágenes
# live-build — ver docs/ROADMAP.md). Solo la carpeta calamares/
# (settings.conf, modules/, branding/) es lo que Calamares espera
# encontrar bajo /etc/calamares/ — el resto del repo (calamares-modules/
# propios de Debian, helpers de branding para el .iso de Debian mismo)
# no aplica a nosotros.
INCLUDES_CALAMARES_DIR="config/includes.chroot/etc/calamares"
echo "==> Copiando vendor/calamares-settings-debian/calamares a includes.chroot/etc/calamares"
mkdir -p "${INCLUDES_CALAMARES_DIR}"
rsync -a --delete \
    "${REPO_ROOT}/vendor/calamares-settings-debian/calamares/" "${INCLUDES_CALAMARES_DIR}/"

# broker/: Likay Agent Broker (ver docs/AGENT_INTERFACE.md, V1 de la
# interfaz genérica de "montar cualquier agente", issue #2 Fase 2).
# Primera parte de ESTE repo, no un submódulo vendor/ -- se excluye
# tests/ (y sus fixtures dummy-agent/malicious-agent) del medio live,
# igual criterio que kal/kal-in excluyendo su propio tests/: no hace
# falta en tiempo de ejecución, solo para desarrollo del propio Broker.
INCLUDES_BROKER_DIR="config/includes.chroot/opt/likay-broker"
echo "==> Copiando broker/ a includes.chroot/opt/likay-broker"
mkdir -p "${INCLUDES_BROKER_DIR}"
rsync -a --delete \
    --exclude='tests' \
    --exclude='__pycache__' \
    --exclude='.pytest_cache' \
    --exclude='*.egg-info' \
    "${REPO_ROOT}/broker/" "${INCLUDES_BROKER_DIR}/"

echo "==> Copiando config/likay/model.conf a includes.chroot/etc/likay-os/"
mkdir -p config/includes.chroot/etc/likay-os
cp config/likay/model.conf config/includes.chroot/etc/likay-os/model.conf

mkdir -p "${MODEL_CACHE_DIR}"
if [ -n "$(ls -A "${MODEL_CACHE_DIR}" 2>/dev/null)" ]; then
    echo "==> Sembrando modelos desde model-cache/ (hardlinks, sin red)"
    # -rf + recrear en vez de sembrar sobre lo que ya hubiera: cp -al no
    # es idempotente contra un destino que ya tiene estos mismos
    # archivos (aunque sea el mismo hardlink de una corrida anterior) —
    # "File exists" con set -e activo aborta TODO el script acá mismo,
    # antes de llegar siquiera a `lb build` (encontrado en vivo).
    rm -rf "${INCLUDES_MODELS_DIR}"
    mkdir -p "${INCLUDES_MODELS_DIR}"
    cp -al "${MODEL_CACHE_DIR}/." "${INCLUDES_MODELS_DIR}/"
else
    mkdir -p "${INCLUDES_MODELS_DIR}"
    echo "==> model-cache/ vacío todavía — el hook de Ollama va a bajar el modelo de verdad esta vez"
fi

sync_models_back() {
    if [ -d "${CHROOT_MODELS_DIR}" ]; then
        echo "==> Sincronizando modelos del chroot de vuelta a model-cache/ (para la próxima build)"
        cp -al "${CHROOT_MODELS_DIR}/." "${MODEL_CACHE_DIR}/" 2>/dev/null \
            || rsync -a "${CHROOT_MODELS_DIR}/" "${MODEL_CACHE_DIR}/"
    fi
}
trap sync_models_back EXIT

# Ahora que forzamos arriba que binary_* corra siempre (no solo la
# primera vez), binary/ de una build anterior queda en el medio:
# lb_binary_syslinux hace algo parecido a "mv chroot/root/isolinux.tmp
# binary/isolinux/isolinux.tmp" — si ese destino YA existe (como
# directorio, de la corrida anterior), Unix mete el origen ADENTRO en
# vez de reemplazarlo ("mv: cannot overwrite 'binary/isolinux/
# isolinux.tmp': El directorio no está vacío", encontrado en vivo).
# `auto/clean --binary` borra binary/ entero para evitar justo esto —
# como ya no dependemos de que el usuario lo corra a mano antes de cada
# build, lo hacemos nosotros acá.
rm -rf binary

# lb_binary_syslinux (de esta versión de live-build) tiene hardcodeado
# "binary/live/" para mover vmlinuz/initrd.img — pero con
# LB_INITRAMFS=casper (lo correcto para --mode ubuntu, y lo que el resto
# del ISO espera: filesystem.squashfs bajo casper/, etc.),
# lb_binary_linux-image los deja en "binary/casper/" en cambio. El script
# SÍ actualiza el parámetro de boot (boot=live -> boot=casper) pero NO el
# path de este mv — soporte de casper incompleto en esta versión. Un
# symlink alcanza: mv a través del symlink opera igual que sobre el
# directorio real. Tiene que rehacerse en cada build porque acabamos de
# borrar binary/ entero (y porque, antes de este cambio, ya lo borraba
# `auto/clean --binary`).
mkdir -p binary
ln -sfn casper binary/live

# (El bootlogo cpio vacío para gfxboot-theme-ubuntu ya NO se pre-crea
# acá — ver config/bootloaders/isolinux/bootlogo: pre-crear
# binary/isolinux/ a mano rompía el `mv chroot/root/isolinux.tmp
# ${_TARGET}` de lb_binary_syslinux — cuando el destino de un mv YA
# existe como directorio, Unix mete el origen ADENTRO en vez de
# reemplazarlo, así que isolinux.bin terminaba enterrado en
# binary/isolinux/isolinux.tmp/ en vez de en binary/isolinux/ directo
# ["genisoimage: Uh oh, I cant find the boot image 'isolinux/isolinux.bin'"].
# La forma correcta es el override que el propio script ya soporta:
# config/bootloaders/<nombre> en vez de su plantilla interna — así el
# bootlogo viaja con el resto de la plantilla y el mv-rename nunca
# encuentra un directorio destino preexistente.)

# Bug real y aislado de lb_binary_syslinux: usa "${_SUFFIX}/live.cfg" en
# la rama casper de LB_INITRAMFS en vez de "${_TARGET}/live.cfg" —
# "_SUFFIX" no se define en ningún lado del script (typo, confirmado con
# grep -rn en todo /usr/lib/live/build y /usr/share/live/build: este es
# el único uso), así que se expande vacío y el sed -i termina apuntando
# a "/live.cfg" (la raíz del filesystem, no existe ahí). Como es una
# variable de shell nunca asignada dentro del script, toma el valor
# heredado del entorno si lo exportamos acá — no hace falta tocar el
# script de live-build.
export _SUFFIX="binary/isolinux"

# Igual que chroot_includes (que SIEMPRE reaplica config/includes.chroot
# por el bug de nombres de marker que ya documentamos en otro lado), acá
# nos chocamos con el problema inverso: el resto de los markers de
# .build/ SÍ funcionan como esperan, y eso es un problema para
# nosotros. chroot/ se conserva entre builds a propósito (para no pagar
# de nuevo el apt/pip de instalar kal, cage, etc. en cada iteración),
# pero eso significa que los hooks de config/hooks/*.chroot (que si
# tocan algo REAL adentro de chroot/, como recompilar cage) y TODA la
# etapa binary_* (que arma filesystem.squashfs y el resto de binary/ a
# partir de chroot/) quedan con su marker ya escrito de la build
# anterior — "W: skipping ..., already done" — y jamás vuelven a
# correr, aunque el contenido de chroot/ haya cambiado de verdad.
# Encontrado en vivo: un hook nuevo que recompilaba cage se instalaba
# bien en chroot/usr/bin/cage (confirmado con `file`/tamaño/timestamp),
# pero el .iso final seguía arrancando con el cage viejo — el
# filesystem.squashfs embebido tenía timestamp de una build de horas
# antes, porque lb_binary_rootfs (junto con chroot_hooks y todo
# binary_*) se había saltado entero. Forzamos que estas etapas corran
# siempre — son justo las que tienen que reflejar el estado actual de
# chroot/ o de config/, no las genuinamente costosas y estables
# (bootstrap: el debootstrap base de Ubuntu) que sí vale la pena
# cachear entre iteraciones.
#
# El mismo problema, encontrado por separado, alcanza también a
# chroot_package-lists/chroot_install-packages: python3-venv está en
# config/package-lists/likay.list.chroot pero dpkg nunca lo tenía
# instalado (confirmado: "un" en dpkg -l) — el marker de esa etapa
# quedó viejo de antes de que python3-venv se agregara a la lista, y
# como nunca se limpiaba, la instalación real de paquetes jamás volvía
# a correr aunque el archivo .list.chroot cambiara. Sintomático recién
# ahora porque el hook de kal (0300) veía el .venv YA armado de una
# build muy anterior (de cuando sí estaba) y no fallaba — hasta que acá
# arriba empezamos a forzar que chroot_hooks corra siempre.
rm -f .build/chroot_hooks .build/chroot_hacks .build/binary_* \
      .build/chroot_package-lists.install .build/chroot_package-lists.live \
      .build/chroot_install-packages.install .build/chroot_install-packages.live

# noauto es obligatorio acá: `lb build` (el comando), si encuentra un
# auto/build ejecutable en el directorio, se relanza solo a través de él
# — es el mecanismo que nos trajo hasta acá (invocamos ESTE script, que
# a su vez llama a `lb build`). Sin "noauto" como primer argumento, esa
# misma detección dispara nuevamente: auto/build -> lb build -> detecta
# auto/build -> lo vuelve a correr -> ad infinitum (pasó de verdad: un
# build real terminó con más de 1000 procesos lb_build corriendo antes
# de poder cortarlo a mano). Ver /usr/lib/live/build/lb_build línea 24:
# `if [ "${1}" != "noauto" ] && [ -x auto/build ]; then ... ./auto/build`.
lb build noauto "${@}" 2>&1 | tee build.log

# lb_binary_iso de esta versión de live-build deja binary.hybrid.iso
# roto de dos formas distintas (símlink binary/live horneado como
# archivo vacío, y el squashfs >4GiB con tamaño mal representado sin
# UDF) — ver el comentario completo en scripts/rebuild-iso-with-fixes.sh.
# Ninguna de las dos se nota en el build en sí (termina "bien"), solo
# arrancando la ISO de verdad.
#
# ESE SCRIPT YA NO SE LLAMA ACÁ AUTOMÁTICAMENTE — se probó (tres veces,
# en vivo) y encadenado así simplemente no aplicaba su propio arreglo
# (confirmado con timestamps: binary/live quedaba con la marca de
# tiempo de ANTES de `lb build`, sin tocar — ni un error visible, ni
# siquiera con el código de salida de `lb build` capturado a mano y
# confirmado en 0). Corrido como comando SEPARADO, en cambio, funcionó
# perfecto las tres veces que se probó así. No se encontró la causa de
# fondo de por qué encadenado falla — en vez de seguir persiguiéndola,
# se lo dejó como un paso manual explícito, que es el que de verdad
# funciona. Ver iso/README.md, sección "Build".
echo "=================================================================="
echo "==> lb build terminó. Ahora corré, como paso aparte:"
echo "==>     sudo ./scripts/rebuild-iso-with-fixes.sh"
echo "==> (encadenarlo automáticamente acá no es confiable — ver el"
echo "==> comentario en este mismo archivo)."
echo "=================================================================="
