#!/bin/sh
# TEMPORAL -- ver com.likay.debug.calamares-gdb.policy. Corre Calamares
# bajo gdb en modo batch para capturar el backtrace real del crash en
# el flujo "Replace a partition" (Segmentation fault, reproducido
# 2026-09-14). Cuando el proceso recibe SIGSEGV, gdb recupera control
# solo (comportamiento default) y corre el siguiente comando -- no
# hace falta manejar la señal a mano.
exec gdb -batch \
    -ex "set pagination off" \
    -ex run \
    -ex "thread apply all bt full" \
    -ex quit \
    /usr/bin/calamares
