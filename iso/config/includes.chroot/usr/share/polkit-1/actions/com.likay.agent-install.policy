<?xml version="1.0" encoding="UTF-8"?>
<!--
     Acción propia, nunca reutiliza com.github.calamares.calamares.pkexec.run
     (ver docs/AGENT_INTERFACE.md: "una única acción Polkit propia,
     separada de Calamares"). org.freedesktop.policykit.exec.path fija
     esta autorización a un único binario de superficie mínima
     (agent-install-helper), con exactamente 6 operaciones nombradas,
     nunca ejecución arbitraria como root. allow_active se queda en
     auth_admin por defecto; la regla real que lo abre sin contraseña
     para el usuario estático likay-agent-install vive en
     etc/polkit-1/rules.d, no acá.
-->
<!DOCTYPE policyconfig PUBLIC
"-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>

 <vendor>Likay-OS</vendor>
 <vendor_url>https://github.com/Kevindelb/Likay-OS</vendor_url>

 <action id="com.likay.agent.install">
    <description>Instalar o gestionar un agente de Likay-OS</description>
    <message>Se requiere autenticación para modificar la configuración de agentes de Likay-OS</message>
    <icon_name>system-run</icon_name>
    <defaults>
     <allow_any>no</allow_any>
     <allow_inactive>no</allow_inactive>
     <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/likay/agent-install-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
 </action>
</policyconfig>
