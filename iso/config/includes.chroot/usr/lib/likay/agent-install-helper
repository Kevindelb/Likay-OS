class HelperError(RuntimeError):
    pass


def _run(cmd: list[str], *, run_as_user: str | None = None, needs_userns: bool = False) -> None:
    """
    Único punto de ejecución de subprocesos de este archivo -- SIEMPRE
    una lista de argumentos (nunca shell=True, nunca una string
    interpolada), así que no hay forma de que un valor derivado del
    manifiesto (un YAML no confiable) inyecte comandos adicionales.

    capture_output=True es obligatorio acá, no cosmético -- bug real
    encontrado en QEMU (2026-09-16): sin esto, la salida de cada
    subproceso (pip install, systemctl, etc.) hereda el propio stdout
    del helper, que es el MISMO pipe que main() usa para el único
    print(json.dumps(result)) final que la TUI espera parsear. En
    cuanto pip tuvo red de verdad y empezó a imprimir progreso
    ("Collecting fastapi...", etc.), ese texto quedó pegado ANTES del
    JSON real, y run_helper() en la TUI fallaba con
    "Expecting value: line 1 column 1 (char 0)" al intentar
    json.loads() sobre el string completo. No se había notado antes
    porque ninguna operación previa producía salida verbosa en stdout.

    run_as_user -- hallazgo real (2026-09-17): sin esto, TODO comando
    corre con la identidad del propio helper (root, vía pkexec). Para
    "python3 -m venv"/pip install de un bundle de terceros eso significa
    que el build backend de cualquier paquete (setup.py, etc.) ejecuta
    código arbitrario COMO ROOT, con red abierta, antes de que exista
    ningún sandbox -- el momento de mayor privilegio de todo el sistema
    para código no confiable. subprocess.run(user=...) (nativo desde
    Python 3.9, sin preexec_fn a mano) baja el proceso hijo al UID/GID
    del usuario dado ANTES de ejecutar -- el blast radius de un paquete
    malicioso pasa de "root total" a "el usuario sin privilegios que se
    acaba de crear para este agente", ya sandboxeado por systemd después.
    HOME se fuerza al home real de ese usuario: sin esto, pip hereda el
    HOME de root (/root), que ese usuario no puede leer/escribir.

    group SE PASA A MANO, no queda implícito -- bug real encontrado en
    QEMU (2026-09-17) probando esto mismo: subprocess.run(user=str) NO
    infiere el grupo primario del usuario solo -- sin group= explícito,
    el proceso hijo hereda el GID del padre (root, grupo 0). Confirmado
    con debugfs sobre el venv resultante: User quedaba en el UID
    correcto del agente, pero Group en 0 (root) -- gid equivocado en
    todo lo que ese proceso creaba, aunque el UID ya estuviera bien.

    extra_groups=[] -- defensa en profundidad (hallazgo 2026-09-17):
    sin esto, run_as_user baja el UID/GID primario pero no hay garantía
    de que se descarten los grupos suplementarios del proceso padre
    (root, vía pkexec). Pasarlo explícito fuerza setgroups(0, NULL) en
    el hijo -- el usuario del agente recién creado (useradd -r) no
    pertenece a ningún grupo extra de todos modos, así que esto no
    cambia el comportamiento real, solo lo deja garantizado en vez de
    implícito. No aplica cuando needs_userns=True -- ver abajo.

    needs_userns -- hallazgo real (2026-09-20, probando load_oci_image
    en QEMU, único attempt limpio de varios): un subprocess.run(user=...)
    corriente (setuid/setgid directo, sin más) NO alcanza para que
    Podman rootless pueda crear su propio user namespace con el rango
    subuid/subgid completo. Confirmado a mano: "podman load" como
    agent-oci-fixture fallaba SIEMPRE con "potentially insufficient
    UIDs or GIDs available in user namespace (requested 0:42 for
    /etc/shadow) ... lchown /etc/shadow: invalid argument", incluso con
    /etc/subuid y /etc/subgid ya correctos (confirmado con getsubids) y
    con la storage del usuario completamente limpia (se descartó la
    hipótesis de estado corrupto por reintentos). El diagnóstico real:
    "newuidmap" (setuid root, se ejecuta para escribir el mapeo
    completo) fallaba con "write to uid_map failed: Operation not
    permitted" -- un simple setuid(2)/setgid(2) vía subprocess.run(user=)
    dijea al proceso corriendo bajo el cgroup de sesión de QUIEN llamó a
    sudo/pkexec (root), sin la delegación de cgroup que el kernel exige
    para permitir CLONE_NEWUSER con un mapeo no trivial ahí. Probado y
    confirmado que alcanza con envolver el comando en
    "systemd-run --uid=... --gid=... --property=Delegate=yes" -- crea
    una unidad transitoria con su PROPIO cgroup delegado desde cero, y
    ahí "podman load" cargó la imagen sin ninguna advertencia. Esto es,
    además, coherente con por qué las unidades Quadlet generadas
    (_quadlet_unit_text) llevan su propio "Delegate=yes" explícito --
    mismo requisito, mismo mecanismo, para cuando el contenedor arranca
    de verdad vía systemd en vez de por este helper.
    """
    env = None
    group = None
    extra_groups = None
    cwd = None
    if run_as_user is not None:
        pw = pwd.getpwnam(run_as_user)
        if needs_userns:
            cmd = [
                "systemd-run", "--pipe", "--wait", "--collect",
                f"--uid={pw.pw_uid}", f"--gid={pw.pw_gid}",
                "--property=Delegate=yes",
                f"--property=WorkingDirectory={pw.pw_dir}",
                f"--setenv=HOME={pw.pw_dir}",
                "--", *cmd,
            ]
            subprocess.run(cmd, check=True, capture_output=True, text=True)
            return
        env = dict(os.environ)
        env["HOME"] = pw.pw_dir
        group = pw.pw_gid
        extra_groups = []
        # Hallazgo real (2026-09-19, probando load_oci_image en QEMU):
        # subprocess.run(user=...) baja el UID/GID pero NUNCA cambia el
        # cwd -- el hijo hereda el directorio de trabajo del propio
        # proceso del helper (el de quien invocó pkexec, no
        # necesariamente accesible para run_as_user). "podman load"
        # falló con "cannot chdir to /home/ubuntu: Permission denied"
        # (el cwd real de la sesión desde la que se probó esto a mano)
        # -- python3 -m venv/pip nunca lo mostraron porque no intentan
        # un chdir a su cwd de arranque, pero el riesgo era el mismo
        # para cualquier run_as_user, no específico de Podman. Fuerza
        # el cwd al home real del usuario, mismo criterio que ya se
        # usa para HOME.
        cwd = pw.pw_dir
    subprocess.run(
        cmd, check=True, capture_output=True, text=True,
        user=run_as_user, group=group, extra_groups=extra_groups, env=env, cwd=cwd,
    )


def _agent_paths(short_id: str) -> dict[str, Path]:
    """
    Storage taxonomy (schema v2, ver docs/AGENT_INTERFACE.md sección
    "Storage"): antes de v2 había un solo directorio "data" genérico --
    "config"/"state"/"workspace"/"secrets" separan explícitamente qué
    es config persistente, qué es estado del propio agente, qué es su
    área de trabajo, y qué son secretos (permisos propios, nunca en el
    mismo directorio que el resto -- ver op_create_agent). "src"/"venv"
    siguen siendo específicos del runtime Python; un runtime OCI (Fase
    C, no implementado todavía) no los necesita pero sí comparte los
    cuatro directorios de storage.
    """
    base = LIKAY_AGENT_MOUNT / short_id
    return {
        "base": base,
        "home": base / "home",
        "config": base / "config",
        "state": base / "state",
        "workspace": base / "workspace",
        "secrets": base / "secrets",
        "src": base / "src",
        "venv": base / "venv",
    }


def _load_manifest_for_operation() -> AgentManifest:
    if not MANIFEST_PATH.is_file():
        raise HelperError(
            f"{MANIFEST_PATH} no existe -- ¿corrió mount_bundle primero?"
        )
    try:
        return parse_manifest_file(MANIFEST_PATH)
    except ManifestError as exc:
        raise HelperError(f"manifiesto inválido: {exc}") from exc


def op_mount_bundle() -> dict:
    LIKAY_AGENT_MOUNT.mkdir(parents=True, exist_ok=True)
    likay_agent_dev = Path("/dev/disk/by-label/likay-agent")
    if not likay_agent_dev.exists():
        raise HelperError("no se encontró la partición likay-agent (/dev/disk/by-label/likay-agent)")
    if not os.path.ismount(LIKAY_AGENT_MOUNT):
        _run(["mount", str(likay_agent_dev), str(LIKAY_AGENT_MOUNT)])

    USB_BUNDLE_MOUNT.mkdir(parents=True, exist_ok=True)
    usb_dev = Path(f"/dev/disk/by-label/{USB_BUNDLE_LABEL}")
    if not usb_dev.exists():
        raise HelperError(
            f"no se encontró ningún medio con etiqueta {USB_BUNDLE_LABEL!r} -- "
            "ver docs/AGENT_INTERFACE.md, transporte del bundle en v1."
        )
    if not os.path.ismount(USB_BUNDLE_MOUNT):
        # ro: el transporte es explícitamente no confiable (invariante
        # de docs/AGENT_INTERFACE.md) -- no hay ninguna razón para que
        # este proceso pueda escribir de vuelta al USB. nosuid,nodev,noexec:
        # "solo lectura" protege contra escritura, no contra un
        # filesystem hostil (FAT/ext4 malformado a propósito) ni contra
        # el contenido que sí trae -- nada necesita ejecutarse ni crear
        # nodos de dispositivo directo desde este mount (install_bundle
        # solo copia bytes vía shutil.copytree, nunca ejecuta nada de
        # acá), así que negarlo a nivel de mount no rompe nada real.
        _run(["mount", "-o", "ro,nosuid,nodev,noexec", str(usb_dev), str(USB_BUNDLE_MOUNT)])

    usb_manifest_path = USB_BUNDLE_MOUNT / "agent.yaml"
    usb_src_dir = USB_BUNDLE_MOUNT / "src"
    usb_image_path = USB_BUNDLE_MOUNT / "image.tar"
    if not usb_manifest_path.is_file():
        raise HelperError(f"{usb_manifest_path} no existe en el medio montado")

    # Copia a staging root-owned de una sola vez -- ver el comentario
    # largo junto a BUNDLE_STAGING (TOCTOU). Todo lo que sigue
    # (validate_manifest, create_agent, install_bundle, generate_unit,
    # load_oci_image) lee de acá, nunca vuelve a tocar el USB.
    if BUNDLE_STAGING.exists():
        shutil.rmtree(BUNDLE_STAGING)
    BUNDLE_STAGING.mkdir(parents=True, mode=0o700)
    shutil.copy2(usb_manifest_path, MANIFEST_PATH)
    if usb_src_dir.is_dir():
        shutil.copytree(usb_src_dir, BUNDLE_SRC_DIR, symlinks=False)
    else:
        BUNDLE_SRC_DIR.mkdir()
    # image.tar (runtime.type: oci, ver BUNDLE_IMAGE_PATH) es opcional
    # acá por el mismo motivo que src/ lo es -- mount_bundle copia lo
    # que haya sin todavía saber qué runtime declara el manifiesto
    # (eso lo decide validate_manifest, un paso después, a propósito:
    # mount_bundle nunca interpreta el manifiesto, solo transporta).
    if usb_image_path.is_file():
        shutil.copy2(usb_image_path, BUNDLE_IMAGE_PATH)

    # El USB ya cumplió su única función (transporte, invariante de
    # docs/AGENT_INTERFACE.md) -- desmontarlo acá, no más tarde, es lo
    # que realmente cierra la ventana: nada de lo que sigue depende de
    # que el medio siga conectado ni sea el mismo.
    _run(["umount", str(USB_BUNDLE_MOUNT)])

    return {
        "manifest_path": str(MANIFEST_PATH),
        "src_dir": str(BUNDLE_SRC_DIR),
        "image_path": str(BUNDLE_IMAGE_PATH) if BUNDLE_IMAGE_PATH.is_file() else None,
    }


def op_validate_manifest() -> dict:
    manifest = _load_manifest_for_operation()
    return {
        "agent_id": manifest.agent_id,
        "short_id": manifest.short_id,
        "capabilities": manifest.capabilities,
        "is_service": manifest.is_service,
        "runtime": manifest.runtime,
        "sandbox": manifest.sandbox,
        "secrets": manifest.secrets,
    }


_KNOWN_RUNTIME_TYPES = ("python", "oci")

# Rango fijo, no calculado por agente -- lícito porque v1 sigue
# soportando un solo agente activo a la vez (ver docs/AGENT_INTERFACE.md,
# "Fuera de alcance de v2"): activate_agent ya hace userdel del usuario
# anterior antes de que este pueda coexistir con uno nuevo, así que no
# hay riesgo real de colisión de rangos entre dos usuarios vivos al
# mismo tiempo.
#
# 1000000, no 100000 -- hallazgo real (2026-09-19, probando esto en
# QEMU): 100000-165535 es el rango que useradd (SIN -r, usuario
# "normal") asigna automáticamente al PRIMER usuario no-sistema que se
# cree en cualquier máquina Debian/Ubuntu (default de
# SUB_UID_MIN/SUB_UID_COUNT en /etc/login.defs) -- exactamente el
# usuario sudo que Calamares crea durante la instalación. Confirmado
# en vivo: el usuario "ubuntu" del propio medio live ya tenía ese rango
# asignado, y coincidía bit a bit con el que create_agent le asignaba
# a mano al usuario del agente -- dos usuarios rootless con el MISMO
# rango subuid/subgid en la misma máquina, condición que rompe el
# aislamiento que ese rango existe para dar. 1000000 está muy por
# encima de lo que cualquier asignación secuencial normal (100000,
# 165536, 231072, ...) alcanzaría con una cantidad razonable de
# usuarios reales en el sistema instalado.
_OCI_SUBID_RANGE = "1000000-1065535"


def _require_known_runtime_type(manifest: AgentManifest) -> str:
    """
    Falla explícito y temprano ante un runtime.type que el schema no
    conoce (defensa en profundidad -- ya lo rechaza el schema, esto
    cubre el caso de un AgentManifest armado a mano sin pasar por
    parse_manifest_text, como en tests). No decide QUÉ hacer con cada
    tipo -- eso lo decide cada operación (create_agent/install_bundle/
    load_oci_image/generate_unit) por su cuenta, python y oci están
    igual de implementados desde Fase C.
    """
    runtime_type = manifest.runtime.get("type")
    if runtime_type not in _KNOWN_RUNTIME_TYPES:
        raise HelperError(f"runtime.type={runtime_type!r} no es un valor legal en v2")
    return runtime_type


def op_create_agent() -> dict:
    manifest = _load_manifest_for_operation()
    runtime_type = _require_known_runtime_type(manifest)
    linux_user = f"agent-{manifest.short_id}"
    paths = _agent_paths(manifest.short_id)

    try:
        pwd.getpwnam(linux_user)
        exists = True
    except KeyError:
        exists = False

    if not exists:
        paths["base"].mkdir(parents=True, exist_ok=True)
        _run([
            "useradd", "-r", "-m", "-d", str(paths["home"]), "-s", "/usr/sbin/nologin", linux_user,
        ])
        if runtime_type == "oci":
            # useradd -r (usuario de SISTEMA) no asigna subuid/subgid
            # solo -- ese auto-asignado de /etc/login.defs
            # (SUB_UID_MIN/SUB_UID_COUNT) es específico de useradd SIN
            # -r. Sin este rango, Podman rootless no puede crear su
            # user namespace para este usuario (hallazgo real,
            # confirmado en el spike de Fase 0, 2026-09-19: sin esto,
            # "podman run" falla con errores de newuidmap/newgidmap).
            _run([
                "usermod",
                "--add-subuids", _OCI_SUBID_RANGE,
                "--add-subgids", _OCI_SUBID_RANGE,
                linux_user,
            ])

    for name in ("config", "state", "workspace"):
        paths[name].mkdir(parents=True, exist_ok=True)
    # secrets, 0700 desde su creación -- nunca comparte permisos con el
    # resto del storage del agente (ver docs/AGENT_INTERFACE.md,
    # sección Secrets). El chown -R de abajo todavía le da el dueño
    # correcto; el modo se fuerza después para no depender del umask.
    paths["secrets"].mkdir(parents=True, exist_ok=True)
    paths["secrets"].chmod(0o700)
    _run(["chown", "-R", f"{linux_user}:{linux_user}", str(paths["base"])])

    return {"linux_user": linux_user}


def op_set_secret() -> dict:
    """
    Escribe UN secret declarado en el manifiesto al storage privado del
    agente (paths["secrets"]/<id>, ya 0700 desde create_agent) -- el
    valor viaja por STDIN, nunca por argv (visible en /proc/<pid>/cmdline
    para CUALQUIER usuario del sistema, no solo root) ni por variable de
    entorno del propio helper. Requiere create_agent ya corrido (hace
    falta el usuario dedicado para el chown).

    Para runtime.type: oci, ADEMÁS crea un Podman secret real en la
    storage rootless del propio usuario del agente ("podman secret
    create", corrido como ese usuario vía needs_userns=True -- mismo
    mecanismo que load_oci_image). _quadlet_unit_text() referencia ese
    secret por nombre (Secret=<id>,type=env,target=<id>) para
    inyectarlo como variable de entorno DENTRO del contenedor sin que
    el valor pase nunca por Image=/Environment= del Quadlet ni quede
    visible vía "podman inspect" -- ver docs/AGENT_INTERFACE.md,
    sección Secrets.

    runtime.type: python NO necesita ningún paso extra acá -- el
    archivo ya queda en paths["secrets"], que _systemd_unit_text() ya
    expone como AGENT_SECRETS_DIR (storage taxonomy existente desde
    Fase A). Ningún agente Python real hoy necesita el valor como
    variable de entorno cruda (son todos de primera parte); ese puente
    queda diferido hasta que un agente Python de terceros real lo
    demuestre necesario -- mismo criterio que ya se aplicó para no
    adivinar de antemano en OCI.
    """
    if len(sys.argv) != 3:
        raise HelperError("set_secret necesita el id del secret como argumento")
    secret_id = sys.argv[2]

    manifest = _load_manifest_for_operation()
    declared_ids = {entry.get("id") for entry in manifest.secrets}
    if secret_id not in declared_ids:
        raise HelperError(f"{secret_id!r} no está declarado en secrets: del manifiesto")

    linux_user = f"agent-{manifest.short_id}"
    try:
        pwd.getpwnam(linux_user)
    except KeyError:
        raise HelperError(f"el usuario {linux_user!r} no existe -- ¿corrió create_agent primero?")

    value = sys.stdin.read()
    if not value:
        raise HelperError(f"valor vacío para el secret {secret_id!r}")

    paths = _agent_paths(manifest.short_id)
    secret_path = paths["secrets"] / secret_id
    secret_path.write_text(value)
    secret_path.chmod(0o600)
    _run(["chown", f"{linux_user}:{linux_user}", str(secret_path)])

    if manifest.runtime.get("type") == "oci":
        _run(
            ["podman", "secret", "create", secret_id, str(secret_path)],
            run_as_user=linux_user, needs_userns=True,
        )

    return {"secret_id": secret_id}


def _enable_installer_network(timeout: float = 25.0) -> None:
    _NETWORKD_DIR.mkdir(parents=True, exist_ok=True)
    _INSTALLER_NETWORK_FILE.write_text(_INSTALLER_NETWORK_CONTENT)
    _run(["systemctl", "start", "systemd-networkd.service"])
    _run(["networkctl", "reload"])

    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        result = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", "scope", "global"],
            capture_output=True, text=True,
        )
        if result.stdout.strip():
            return
        time.sleep(1)
    raise HelperError(
        "no se pudo obtener una dirección de red (DHCP) a tiempo -- "
        "install_bundle necesita conectividad temporal para pip install"
    )


def _disable_installer_network() -> None:
    """
    Apaga la red del instalador incondicionalmente -- se llama desde un
    finally/, así que nunca puede dejarse la interfaz arriba por un
    error a mitad de pip install. Nunca toca la política del agente
    (sandbox.network sigue viniendo solo del manifiesto).
    """
    subprocess.run(["systemctl", "stop", "systemd-networkd.service"], check=False)
    if _INSTALLER_NETWORK_FILE.exists():
        _INSTALLER_NETWORK_FILE.unlink()


def op_install_bundle() -> dict:
    """
    Específica de runtime.type: python (venv + pip) -- el equivalente
    para runtime.type: oci es load_oci_image, no esta operación (el
    TUI/launcher elige cuál llamar según runtime.type, ya lo sabe desde
    validate_manifest). No es un "if oci: ... else: ..." acá adentro a
    propósito: cada runtime tiene su propia operación con su propio
    nombre, en vez de una sola función genérica con ramas -- mismo
    criterio que install_bundle/load_oci_image ya eran operaciones
    separadas desde Fase B.
    """
    manifest = _load_manifest_for_operation()
    if not manifest.is_service:
        raise HelperError(f"{manifest.agent_id} no tiene runtime -- no es un servicio instalable")
    runtime_type = _require_known_runtime_type(manifest)
    if runtime_type != "python":
        raise HelperError(f"install_bundle es solo para runtime.type: python -- este manifiesto declara {runtime_type!r} (usar load_oci_image)")

    linux_user = f"agent-{manifest.short_id}"
    paths = _agent_paths(manifest.short_id)

    requirements_file = manifest.runtime.get("python", {}).get("requirements_file")
    if not requirements_file:
        raise HelperError("runtime.python.requirements_file falta en el manifiesto")
    # Revalida el path DE NUEVO acá, contra el src/ real del bundle --
    # nunca confía en que el TUI ya lo haya validado antes.
    validate_requirements_path(BUNDLE_SRC_DIR, requirements_file)

    if paths["src"].exists():
        shutil.rmtree(paths["src"])
    shutil.copytree(BUNDLE_SRC_DIR, paths["src"], symlinks=False)
    # chown ACÁ, antes de crear el venv/correr pip como este usuario --
    # shutil.copytree corrió como root (el propio proceso), así que
    # src/ y su contenido quedan root:root pese a que paths["base"] ya
    # es de linux_user (la ownership de un directorio padre no se
    # hereda a los hijos que ya existían al copiarlos).
    _run(["chown", "-R", f"{linux_user}:{linux_user}", str(paths["src"])])

    # Hallazgo real (2026-09-17): python3 -m venv y pip install corrían
    # como root (el propio proceso del helper) -- ver el docstring de
    # _run(run_as_user=...). Corren como linux_user desde acá en
    # adelante: el build backend de cualquier paquete de terceros
    # (setup.py, etc.) ejecuta como ese usuario sin privilegios, nunca
    # como root.
    _run(["python3", "-m", "venv", str(paths["venv"])], run_as_user=linux_user)

    # Ventana de red mínima: solo alrededor de los dos pip install que
    # de verdad la necesitan -- ni la copia del bundle ni la creación
    # del venv la requieren. Se apaga en el finally pase lo que pase.
    _enable_installer_network()
    try:
        _run(
            [str(paths["venv"] / "bin" / "pip"), "install", "--no-cache-dir", "--upgrade", "pip"],
            run_as_user=linux_user,
        )
        _run(
            [
                str(paths["venv"] / "bin" / "pip"), "install", "--no-cache-dir",
                "-r", str(paths["src"] / requirements_file),
            ],
            run_as_user=linux_user,
        )
    finally:
        _disable_installer_network()

    return {"installed": True}


def _parse_loaded_image_ref(load_stdout: str) -> str:
    for line in load_stdout.splitlines():
        if line.startswith("Loaded image:"):
            return line.removeprefix("Loaded image:").strip()
    raise HelperError(f"no se pudo determinar qué imagen cargó podman load: {load_stdout!r}")


def op_load_oci_image() -> dict:
    """
    Carga la imagen ya transportada (BUNDLE_IMAGE_PATH, nunca un pull
    de red, invariante 15) y verifica que su digest real coincida con
    runtime.oci.image.digest -- si no coincide, la borra de inmediato
    (invariante 13, cadena de suministro no confiable). Específica de
    runtime.type: oci, mismo criterio que install_bundle lo es de
    python (ver su docstring).

    Requiere que create_agent ya haya corrido (necesita el usuario
    dedicado y su rango subuid/subgid, Fase C) -- a diferencia de
    install_bundle, que solo necesita el usuario existir para el
    chown, load_oci_image necesita el subuid/subgid para el segundo
    "podman load" de abajo.

    Dos cargas, a propósito, no una:
    1. Como root -- ÚNICAMENTE para verificar el digest antes de
       exponerle nada al usuario del agente (Fase B, sin cambios).
    2. Como el usuario dedicado del agente, a su propia storage
       rootless -- Podman corre así cuando el Quadlet generado
       (generate_unit) arranque el contenedor de verdad, así que la
       imagen tiene que existir AHÍ, no en la storage de root. La
       copia de root se borra al final (higiene, mismo criterio que
       BUNDLE_STAGING en activate_agent) -- no hay razón para dejarla
       para siempre.
    """
    manifest = _load_manifest_for_operation()
    runtime = manifest.runtime
    if runtime.get("type") != "oci":
        raise HelperError(
            f"runtime.type={runtime.get('type')!r} no usa load_oci_image -- solo 'oci' lo necesita"
        )

    if not BUNDLE_IMAGE_PATH.is_file():
        raise HelperError(f"{BUNDLE_IMAGE_PATH} no existe -- ¿el bundle traía image.tar?")

    declared_digest = runtime.get("oci", {}).get("image", {}).get("digest")
    if not declared_digest:
        raise HelperError("runtime.oci.image.digest falta en el manifiesto")

    linux_user = f"agent-{manifest.short_id}"
    paths = _agent_paths(manifest.short_id)
    try:
        pwd.getpwnam(linux_user)
    except KeyError:
        raise HelperError(f"el usuario {linux_user!r} no existe -- ¿corrió create_agent primero?")

    # 1) Carga + verifica como root -- integridad antes de exponerle
    # nada al usuario del agente. "podman load" imprime "Loaded image:
    # <referencia>" por stdout -- se captura esa referencia EXACTA para
    # inspeccionar después precisamente la imagen recién cargada, en
    # vez de adivinar por runtime.oci.image.reference (que podría no
    # coincidir con el nombre/tag real embebido en el archivo).
    load_result = subprocess.run(
        ["podman", "load", "-i", str(BUNDLE_IMAGE_PATH)],
        check=True, capture_output=True, text=True,
    )
    loaded_ref = _parse_loaded_image_ref(load_result.stdout)

    inspect_result = subprocess.run(
        ["podman", "inspect", "--format", "{{.Digest}}", loaded_ref],
        check=True, capture_output=True, text=True,
    )
    actual_digest = inspect_result.stdout.strip()

    if actual_digest != declared_digest:
        subprocess.run(
            ["podman", "rmi", "-f", loaded_ref], check=False, capture_output=True, text=True,
        )
        raise HelperError(
            f"digest de la imagen cargada ({actual_digest}) no coincide con "
            f"runtime.oci.image.digest declarado ({declared_digest}) -- imagen rechazada y borrada"
        )

    # 2) Ya verificada -- cargar la MISMA imagen a la storage rootless
    # del usuario dedicado. No se puede leer BUNDLE_IMAGE_PATH
    # directamente como ese usuario -- BUNDLE_STAGING es root-owned
    # 0700 a propósito (cierra el TOCTOU del manifiesto, ver el
    # comentario junto a esa constante), así que "podman load" como
    # linux_user fallaba con "permission denied" al intentar leerlo
    # (hallazgo real, 2026-09-19). Se copia primero a paths["base"]
    # (ya paths["base"] es de linux_user desde create_agent) y se
    # chownea explícito -- mismo patrón exacto que install_bundle ya
    # usa para src/ (copiar afuera del staging root-only, después
    # operar como el usuario sin privilegios).
    agent_image_copy = paths["base"] / "image.tar"
    shutil.copy2(BUNDLE_IMAGE_PATH, agent_image_copy)
    _run(["chown", f"{linux_user}:{linux_user}", str(agent_image_copy)])
    _run(["podman", "load", "-i", str(agent_image_copy)], run_as_user=linux_user, needs_userns=True)
    agent_image_copy.unlink()

    # Limpieza -- la copia de root era solo para verificar.
    subprocess.run(["podman", "rmi", "-f", loaded_ref], check=False, capture_output=True, text=True)

    return {"loaded_image": loaded_ref, "digest": actual_digest}


_SANDBOX_BASE_DIRECTIVES = [
    "NoNewPrivileges=yes",
    "ProtectKernelTunables=yes",
    "ProtectKernelModules=yes",
    "ProtectControlGroups=yes",
    "RestrictSUIDSGID=yes",
    "LockPersonality=yes",
    "SystemCallFilter=@system-service",
]


def _systemd_unit_text(manifest: AgentManifest, linux_user: str) -> str:
    """
    Traduce sandbox:/runtime: del manifiesto a directivas systemd
    concretas -- ver la tabla de mapeo en docs/AGENT_INTERFACE.md
    sección Sandbox. bind_host NUNCA sale del manifiesto (no es un campo
    legal, ver manifest.py/el schema) -- acá se fuerza --host
    127.0.0.1 por construcción, sin excepción.
    """
    paths = _agent_paths(manifest.short_id)
    sandbox = manifest.sandbox
    runtime = manifest.runtime

    directives = list(_SANDBOX_BASE_DIRECTIVES)

    fs = sandbox.get("filesystem", "none")
    directives += ["ProtectSystem=strict", "ProtectHome=yes", "PrivateTmp=yes"]
    if fs == "restricted":
        # Storage taxonomy (schema v2): config/state/workspace son
        # escritura persistente del propio agente; secrets se expone
        # también (el proceso necesita LEER sus credenciales) pero ya
        # quedó 0700 en op_create_agent -- ReadWritePaths no cambia
        # esos permisos, solo lo que systemd deja escribir/leer más
        # allá de lo que ProtectSystem=strict permite por defecto.
        for name in ("config", "state", "workspace", "secrets"):
            directives.append(f"ReadWritePaths={paths[name]}")
    elif fs != "none":
        raise HelperError(f"sandbox.filesystem={fs!r} no es un valor legal en v2")

    network = sandbox.get("network", "none")
    if network == "none":
        directives.append("PrivateNetwork=yes")
    elif network != "host-egress":
        raise HelperError(f"sandbox.network={network!r} no es un valor legal en v2")

    devices = sandbox.get("devices", "none")
    if devices == "none":
        directives.append("PrivateDevices=yes")
    elif devices == "explicit":
        directives.append("PrivateDevices=no")
        directives.append("DevicePolicy=closed")
        for entry in sandbox.get("device_allow", []):
            directives.append(f"DeviceAllow={entry}")
    else:
        raise HelperError(f"sandbox.devices={devices!r} no es un valor legal en v2")

    if "memory_max" in sandbox:
        directives.append(f"MemoryMax={sandbox['memory_max']}")
    if "cpu_quota" in sandbox:
        directives.append(f"CPUQuota={sandbox['cpu_quota']}")
    if "tasks_max" in sandbox:
        directives.append(f"TasksMax={sandbox['tasks_max']}")

    # op_generate_unit ya garantizó runtime.type == "python" antes de
    # llamar a esta función -- runtime.python existe siempre que este
    # punto se alcanza.
    python_runtime = runtime.get("python", {})
    port = runtime.get("port")
    command = python_runtime.get("command", "")
    entry_point = python_runtime.get("entry_point", "")
    exec_start = f"{paths['venv']}/bin/{command} {entry_point} --host 127.0.0.1 --port {port}"

    env_lines = "\n".join(
        f"Environment={k}={v}" for k, v in runtime.get("env", {}).items()
    )
    # AGENT_CONFIG_DIR/AGENT_STATE_DIR/AGENT_WORKSPACE_DIR/AGENT_SECRETS_DIR:
    # storage taxonomy de schema v2 -- reemplaza el AGENT_DATA_DIR único
    # de v1. Un agente que solo conocía AGENT_DATA_DIR (fixtures v1)
    # necesita actualizarse al migrar; ver docs/AGENT_INTERFACE.md,
    # sección "Migración desde schema v1".
    env_lines += f"\nEnvironment=AGENT_CONFIG_DIR={paths['config']}"
    env_lines += f"\nEnvironment=AGENT_STATE_DIR={paths['state']}"
    env_lines += f"\nEnvironment=AGENT_WORKSPACE_DIR={paths['workspace']}"
    env_lines += f"\nEnvironment=AGENT_SECRETS_DIR={paths['secrets']}"

    directive_lines = "\n".join(directives)

    return f"""[Unit]
Description=Likay-OS agent -- {manifest.agent_id} (generado por agent-install-helper)
# RequiresMountsFor -- no ConditionKernelCommandLine ni [Install] en
# mnt-likay\\x2dagent.mount (ver el comentario largo ahí, bug real
# 2026-09-16): systemd resuelve solo qué .mount cubre esta ruta y lo
# monta bajo demanda, SOLO porque este agente concreto lo necesita --
# nada lo pide en un arranque de kiosco sin ningún agente instalado.
RequiresMountsFor={paths['base']}
After=network.target likay-agent-broker.service

[Service]
Type=simple
User={linux_user}
Group={linux_user}
WorkingDirectory={paths['src']}
{env_lines}
ExecStart={exec_start}
Restart=on-failure
RestartSec=2
StandardOutput=journal+console
StandardError=journal+console
{directive_lines}

[Install]
WantedBy=multi-user.target
"""


def _quadlet_unit_text(manifest: AgentManifest, linux_user: str) -> str:
    """
    Sandbox Adapter OCI (Fase C, ver docs/AGENT_INTERFACE.md sección
    Sandbox): equivalente de _systemd_unit_text() para runtime.type:
    oci, generando un Quadlet (podman-systemd.unit(5)) en vez de una
    unidad .service a mano -- systemd lo convierte en una unidad real
    (mismo nombre, likay-agent-<short_id>.service) al arrancar, vía el
    generador que trae el paquete podman.

    Mismos principios que _systemd_unit_text(): artefacto declarativo
    generado desde campos ya validados, nunca un comando arbitrario
    (invariante 7) -- nunca se usa PodmanArgs= (el escape hatch de
    Quadlet hacia flags libres de `podman run`), todo son claves
    estructuradas de [Container]/[Service].

    [Container] User= es DISTINTO de [Service] User= -- hallazgo real
    del spike de Fase 0 (2026-09-19): el primero fija el usuario DENTRO
    de la imagen (por nombre, tiene que existir en su /etc/passwd), no
    el usuario del host que corre Podman. Nunca se usa acá: no
    controlamos qué usuarios trae una imagen de terceros. La identidad
    de host (quién corre Podman, y por lo tanto quién es dueño del
    contenedor y sus namespaces) se fija con [Service] User=/Group=,
    igual que en el caso Python.
    """
    paths = _agent_paths(manifest.short_id)
    sandbox = manifest.sandbox
    runtime = manifest.runtime
    oci_runtime = runtime.get("oci", {})
    image = oci_runtime.get("image", {})
    # Hallazgo real (2026-09-20, probando OpenClaw real en QEMU): usar
    # solo `image.reference` (sin digest) en Image= deja que Quadlet le
    # agregue ":latest" por su cuenta si esa referencia exacta no está
    # en la storage local -- y "cargado por load_oci_image" no implica
    # "cargado bajo el tag :latest" (el fixture de prueba coincidía por
    # casualidad; la imagen real de OpenClaw se probó bajo el tag
    # :slim, no :latest). Sin el digest, Quadlet intentó un pull de red
    # real contra ghcr.io -- justo lo que artifact.transport:
    # local-oci-archive existe para evitar (invariante 15). Fijar
    # SIEMPRE la referencia por digest (`ref@sha256:...`) resuelve a la
    # imagen ya cargada sin importar bajo qué tag venía en el archivo,
    # y es además lo correcto por la invariante 13 (nunca confiar en un
    # tag mutable en el momento de arrancar, solo en el digest fijado).
    image_ref = f"{image.get('reference')}@{image.get('digest')}"

    container_directives = ["NoNewPrivileges=true", "DropCapability=ALL"]

    fs = sandbox.get("filesystem", "none")
    if fs == "restricted":
        container_directives.append("ReadOnly=true")
        # Mismos cuatro directorios que el caso Python (sección
        # Storage), montados a una ruta fija DENTRO del contenedor --
        # nunca derivada del manifiesto, así que ningún agente puede
        # pedir que se le monte algo en otro lado.
        #
        # :U -- hallazgo real (2026-09-20, probando OpenClaw real en
        # QEMU): sin esto, el volumen aparece DENTRO del contenedor con
        # el dueño que resulta de la identidad del host (container UID
        # 0, vía la primera línea del mapeo rootless), nunca el usuario
        # no-root que la imagen declara correr (p.ej. "node", UID 1000
        # interno, el caso de OpenClaw) -- ese usuario no-root se
        # encontraba con el volumen dueño de "root" (desde SU vista) y
        # no podía escribir nada ahí, aunque el volumen fuera
        # legítimamente de su propio agente. `:U` le pide a Podman que
        # ajuste el dueño real del volumen para que coincida con el
        # UID/GID que el contenedor va a usar -- necesario para
        # cualquier imagen de terceros que corra como no-root (un
        # patrón común y recomendado en imágenes bien comportadas, no
        # una rareza de OpenClaw). Coexiste con `Z` (reetiquetado
        # SELinux) separado por coma, sintaxis estándar de Podman para
        # combinar opciones de montaje.
        for name in ("config", "state", "workspace", "secrets"):
            container_directives.append(f"Volume={paths[name]}:/var/lib/likay-agent/{name}:Z,U")
    elif fs != "none":
        raise HelperError(f"sandbox.filesystem={fs!r} no es un valor legal en v2")

    network = sandbox.get("network", "none")
    if network == "none":
        container_directives.append("Network=none")
    elif network != "host-egress":
        raise HelperError(f"sandbox.network={network!r} no es un valor legal en v2")
    # host-egress: sin Network=, Podman rootless usa su red por
    # defecto (pasta/slirp4netns) -- acceso normal a la red del host,
    # mismo significado que en la tabla de mapeo de la sección Sandbox.

    devices = sandbox.get("devices", "none")
    if devices == "explicit":
        # AddDevice= de Quadlet usa ':' (host[:contenedor][:permisos]),
        # NO el '<device> <permisos>' de DeviceAllow= de systemd puro
        # -- para runtime.type: oci, device_allow tiene que declararse
        # ya en sintaxis AddDevice=. Documentado en
        # docs/AGENT_INTERFACE.md.
        for entry in sandbox.get("device_allow", []):
            container_directives.append(f"AddDevice={entry}")
    elif devices != "none":
        raise HelperError(f"sandbox.devices={devices!r} no es un valor legal en v2")

    port = runtime.get("port")
    if port:
        container_directives.append(f"PublishPort=127.0.0.1:{port}:{port}")

    for k, v in runtime.get("env", {}).items():
        container_directives.append(f"Environment={k}={v}")
    container_directives.append("Environment=AGENT_CONFIG_DIR=/var/lib/likay-agent/config")
    container_directives.append("Environment=AGENT_STATE_DIR=/var/lib/likay-agent/state")
    container_directives.append("Environment=AGENT_WORKSPACE_DIR=/var/lib/likay-agent/workspace")
    container_directives.append("Environment=AGENT_SECRETS_DIR=/var/lib/likay-agent/secrets")

    # Secret=<id>,type=env,target=<id> -- op_set_secret() ya creó el
    # Podman secret con este mismo nombre en la storage rootless del
    # usuario del agente (ver su docstring). El valor nunca pasa por
    # Image=/Environment= de este archivo ni por argv del helper -- solo
    # el NOMBRE del secret aparece acá, nunca el valor. "id" es
    # literalmente el nombre de la variable de entorno a inyectar
    # DENTRO del contenedor (misma convención que ya usa el ejemplo de
    # OpenClaw en docs/AGENT_INTERFACE.md: id: OPENCLAW_GATEWAY_TOKEN)
    # -- sin campo nuevo de mapeo en el schema.
    for entry in manifest.secrets:
        secret_id = entry.get("id")
        container_directives.append(f"Secret={secret_id},type=env,target={secret_id}")

    # Delegate=yes -- hallazgo real (2026-09-20, probando load_oci_image
    # en QEMU): sin esto, Podman rootless no puede crear su propio user
    # namespace con el rango subuid/subgid completo -- newuidmap falla
    # con "write to uid_map failed: Operation not permitted" a pesar de
    # que /etc/subuid ya tiene el rango correcto asignado (confirmado
    # con getsubids). La unidad generada corre bajo su propio cgroup
    # delegado desde el arranque (a diferencia de un simple setuid), así
    # que systemd ya le da la delegación que Podman necesita -- mismo
    # motivo por el que _run(needs_userns=True) tiene que envolver
    # "podman load" en systemd-run en vez de un subprocess.run(user=...)
    # directo (ver ese comentario para el diagnóstico completo).
    service_directives = ["Delegate=yes"]
    if "memory_max" in sandbox:
        service_directives.append(f"MemoryMax={sandbox['memory_max']}")
    if "cpu_quota" in sandbox:
        service_directives.append(f"CPUQuota={sandbox['cpu_quota']}")
    if "tasks_max" in sandbox:
        service_directives.append(f"TasksMax={sandbox['tasks_max']}")

    container_lines = "\n".join(container_directives)
    service_lines = "\n".join(service_directives)

    return f"""[Unit]
Description=Likay-OS agent (OCI) -- {manifest.agent_id} (generado por agent-install-helper)
RequiresMountsFor={paths['base']}
After=network.target likay-agent-broker.service

[Container]
Image={image_ref}
{container_lines}

[Service]
User={linux_user}
Group={linux_user}
Restart=on-failure
RestartSec=2
{service_lines}

[Install]
WantedBy=multi-user.target
"""


QUADLET_DIR = Path("/etc/containers/systemd")


def op_generate_unit() -> dict:
    """
    Dispatch por runtime.type -- python escribe un .service a mano
    (_systemd_unit_text) en /etc/systemd/system/; oci escribe un
    Quadlet .container (_quadlet_unit_text) en /etc/containers/systemd/,
    que el propio generador de Podman convierte en una unidad real al
    arrancar. Mismo nombre resultante en ambos casos
    (likay-agent-<short_id>.service) -- op_activate_agent no necesita
    saber cuál de los dos generó la unidad.
    """
    manifest = _load_manifest_for_operation()
    if not manifest.is_service:
        raise HelperError(f"{manifest.agent_id} no tiene runtime -- no es un servicio instalable")
    runtime_type = _require_known_runtime_type(manifest)

    linux_user = f"agent-{manifest.short_id}"
    if runtime_type == "python":
        unit_text = _systemd_unit_text(manifest, linux_user)
        unit_path = Path(f"/etc/systemd/system/likay-agent-{manifest.short_id}.service")
    else:
        unit_text = _quadlet_unit_text(manifest, linux_user)
        QUADLET_DIR.mkdir(parents=True, exist_ok=True)
        unit_path = QUADLET_DIR / f"likay-agent-{manifest.short_id}.container"
    unit_path.write_text(unit_text)
    unit_path.chmod(0o644)

    return {"unit_path": str(unit_path)}


def op_activate_agent() -> dict:
    manifest = _load_manifest_for_operation()
    runtime_type = manifest.runtime.get("type")
    unit_name = f"likay-agent-{manifest.short_id}.service"

    # Un solo agente activo a la vez (ver docs/AGENT_INTERFACE.md
    # "fuera de alcance de v1") -- para cualquier OTRO
    # likay-agent-*.service que esté activo, lo detiene y deshabilita
    # antes de activar el nuevo.
    deactivated_linux_users: list[str] = []
    existing = subprocess.run(
        # --plain -- hallazgo real (2026-09-20, reactivando sobre una
        # unidad OpenClaw previamente fallida en QEMU): sin esto,
        # systemctl antepone un glifo "●" como primera columna para
        # cualquier unidad listada que esté en estado "failed" -- el
        # `line.split()[0]` de abajo agarraba ESE glifo en vez del
        # nombre real de la unidad, y el intento de
        # "systemctl disable" sobre "●" fallaba con "Invalid unit name".
        # No es específico de OpenClaw ni de Quadlet -- cualquier unidad
        # `likay-agent-*` que haya fallado antes de ser reemplazada
        # dispara el mismo bug. --plain suprime el glifo, salida
        # tabular pura.
        ["systemctl", "list-units", "--type=service", "--all", "--plain", "--no-legend", "likay-agent-*.service"],
        check=True, capture_output=True, text=True,
    ).stdout
    for line in existing.splitlines():
        other_unit = line.split()[0] if line.split() else ""
        if other_unit and other_unit != unit_name and other_unit not in INFRA_UNITS:
            other_short_id = other_unit.removeprefix("likay-agent-").removesuffix(".service")
            other_quadlet_file = QUADLET_DIR / f"likay-agent-{other_short_id}.container"
            if other_quadlet_file.is_file():
                # Unidad generada por Quadlet (runtime.type: oci) --
                # "systemctl disable" no aplica acá, mismo motivo que
                # "enable" más abajo ("is transient or generated",
                # hallazgo real 2026-09-19). Se detiene y se borra el
                # .container FUENTE -- si no, el generador de Quadlet
                # la vuelve a considerar "wanted" (por su propio
                # [Install]) en el siguiente daemon-reload/boot, sin
                # importar el stop.
                _run(["systemctl", "stop", other_unit])
                other_quadlet_file.unlink()
            else:
                _run(["systemctl", "disable", "--now", other_unit])

            # Hallazgo real (2026-09-17): hasta acá, el agente viejo
            # quedaba desactivado pero su usuario Linux y su grant en
            # el Broker (policy.json) nunca se limpiaban -- quedaban
            # huérfanos para siempre en cada reinstalación con un
            # agente DISTINTO (v1 soporta uno solo activo a la vez).
            # remove_grant() ya existía en policy_store.py sin ningún
            # caller; acá se resuelve el otro lado, userdel, y se junta
            # la lista de usuarios para que el caller (la TUI, la única
            # que puede hablarle al Broker directo) limpie su grant vía
            # el nuevo método unregister_policy.
            other_linux_user = f"agent-{other_short_id}"
            try:
                pwd.getpwnam(other_linux_user)
            except KeyError:
                continue  # no debería pasar (el nombre viene de una unidad real), pero no es fatal
            _run(["userdel", other_linux_user])
            deactivated_linux_users.append(other_linux_user)

    _run(["systemctl", "daemon-reload"])
    if runtime_type == "oci":
        # Unidades generadas por Quadlet (systemd-quadlet-generator) no
        # se pueden "systemctl enable" -- fallan con "Unit .../....service
        # is transient or generated" (hallazgo real, 2026-09-19). Ya
        # quedan "habilitadas" implícitamente por el propio [Install]
        # del .container fuente, que el generador lee en cada
        # daemon-reload/boot -- alcanza con arrancarla.
        _run(["systemctl", "start", unit_name])
    else:
        _run(["systemctl", "enable", "--now", unit_name])

    # /etc/likay-os/ es root:root -- la TUI (corre como
    # likay-agent-install, sin privilegios) no puede escribir ahí.
    # Bug real encontrado en QEMU (2026-09-16): la TUI intentaba
    # escribirlo directo después de activate_agent, con un
    # PermissionError sin capturar que tumbaba el proceso entero
    # (Main process exited, status=1) justo después de que el agente
    # ya había quedado activo -- la pantalla se quedaba congelada en
    # "Paso 6/6" para siempre, sin ningún mensaje de error visible.
    port = manifest.runtime.get("port")
    if port:
        ACTIVE_AGENT_CONF.parent.mkdir(parents=True, exist_ok=True)
        ACTIVE_AGENT_CONF.write_text(f"AGENT_URL=http://127.0.0.1:{port}\n")

    # Higiene, no seguridad -- hallazgo 2026-09-17: BUNDLE_STAGING
    # (root:root 0700, no explotable) quedaba para siempre en el disco
    # instalado con una copia completa del código de un agente de
    # terceros. El agente ya activo tiene su propia copia en paths["src"]
    # (con su venv al lado); esta era solo la copia de trabajo del
    # helper para cerrar el TOCTOU durante la instalación misma.
    if BUNDLE_STAGING.exists():
        shutil.rmtree(BUNDLE_STAGING)

    return {"unit": unit_name, "port": port, "deactivated_linux_users": deactivated_linux_users}


def op_reboot() -> dict:
    # Operación fija de propósito único (invariante 7 de
    # docs/AGENT_INTERFACE.md) -- no "ejecutar comando arbitrario",
    # literalmente "systemctl reboot" hardcodeado. Bug real encontrado
    # en hardware físico (2026-09-17): la pantalla final de la TUI
    # ("Instalación completa... Reiniciá para volver al modo kiosco
    # normal") solo esperaba una tecla y el proceso terminaba ahí --
    # nunca reiniciaba de verdad. Con Restart=no en
    # likay-agent-install.service y tty1 liberado de getty mientras
    # corría (Conflicts=getty@tty1.service, nunca restaurado al parar),
    # la pantalla quedaba muerta, sin nada escuchando teclado -- el
    # usuario tenía que apagar a la fuerza. La TUI corre sin privilegios
    # (invariante 1/2), así que el reboot pasa por acá, como el resto de
    # las operaciones privilegiadas.
    _run(["systemctl", "reboot"])
    return {}


_DISPATCH = {
    "mount_bundle": op_mount_bundle,
    "validate_manifest": op_validate_manifest,
    "create_agent": op_create_agent,
    "install_bundle": op_install_bundle,
    "generate_unit": op_generate_unit,
    "activate_agent": op_activate_agent,
    "reboot": op_reboot,
    "load_oci_image": op_load_oci_image,
    "set_secret": op_set_secret,
}


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] not in OPERATIONS:
        print(
            f"uso: {argv[0]} <{'|'.join(OPERATIONS)}>",
            file=sys.stderr,
        )
        return 2

    operation = argv[1]
    # set_secret es la ÚNICA operación con un argumento extra (el id del
    # secret -- nunca el valor, ese viaja por stdin dentro de
    # op_set_secret). Todas las demás siguen exigiendo exactamente 2
    # argumentos, sin excepción -- invariante 7, ninguna operación
    # acepta parámetros libres.
    expected_argc = 3 if operation == "set_secret" else 2
    if len(argv) != expected_argc:
        print(
            f"uso: {argv[0]} set_secret <secret_id>" if operation == "set_secret"
            else f"uso: {argv[0]} <{'|'.join(OPERATIONS)}>",
            file=sys.stderr,
        )
        return 2
    try:
        result = _DISPATCH[operation]()
    except HelperError as exc:
        print(json.dumps({"error": str(exc)}), file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        # exc.stderr/exc.stdout (poblados por capture_output=True en
        # _run) tienen el detalle real -- str(exc) solo dice el
        # returncode, nada útil para diagnosticar (p.ej. el mensaje de
        # pip sobre por qué falló la resolución de dependencias).
        detail = (exc.stderr or exc.stdout or str(exc)).strip()
        print(json.dumps({"error": f"comando falló: {detail}"}), file=sys.stderr)
        return 1

    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
