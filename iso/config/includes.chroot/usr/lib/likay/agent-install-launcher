#!/opt/likay-broker/.venv/bin/python3
"""
TUI de instalación de agentes -- corre como el usuario sin privilegios
likay-agent-install (ExecStart de likay-agent-install.service, ver
docs/AGENT_INTERFACE.md sección 3). NUNCA escala directo: cada paso
privilegiado se hace vía "pkexec agent-install-helper <operación>",
autorizado por una acción PolicyKit propia
(com.likay.agent-install.policy + 61-likay-agent-install.rules) scoped
específicamente a este usuario.

Secuencia (ver docs/AGENT_INTERFACE.md sección 3 / el plan de
implementación):
  1. Confirmación
  2. helper mount_bundle -- copia el manifiesto+src/ a un staging
     root-owned y desmonta el USB ahí mismo (TOCTOU cerrado, ver el
     comentario largo junto a BUNDLE_STAGING en agent-install-helper) --
     el USB ya puede desconectarse después de este paso.
  3. helper validate_manifest -- se muestra el resultado
  4. Aprobación explícita de cada capability
  5. Si hay otro agente activo, ofrecer desactivarlo (ver activate_agent,
     que igual lo hace de forma atómica -- esto es solo para avisar)
  6-8. helper create_agent / install_bundle (venv + pip corren como el
     UID/GID del agente recién creado, nunca como root) / generate_unit
  9. ESTA TUI (no el helper) llama register_policy directo al Broker,
     vía su propia credencial Unix -- nunca necesita pkexec para esto.
  10. helper activate_agent -- ya escribe /etc/likay-os/active-agent.conf
     y limpia el staging del paso 2 (esta TUI, sin privilegios, no
     puede tocar ninguna de las dos cosas directo).
  11. helper reboot -- la pantalla final espera una tecla y reinicia de
     verdad (ver _reboot_or_show_fallback).

curses corre bien sobre consola serie (console=ttyS0,115200n8, ya en
la línea de arranque de likay.mode=agent-install) con TERM=linux --
esto es lo que hace posible automatizar esta TUI en QEMU sin VNC/Xorg,
mismo espíritu que el resto de las pruebas de este proyecto.
"""
from __future__ import annotations

import curses
import json
import subprocess
import sys

HELPER = "/usr/lib/likay/agent-install-helper"

# Mismo motivo y misma lista que INFRA_UNITS en agent-install-helper --
# el glob likay-agent-*.service matchea al propio Broker, que no es un
# agente instalado (bug real encontrado en QEMU 2026-09-16).
INFRA_UNITS = frozenset({"likay-agent-broker.service", "likay-agent-install.service"})

sys.path.insert(0, "/opt/likay-broker")
from likay_broker.client import BrokerClientError, register_policy, unregister_policy  # noqa: E402


class InstallAborted(Exception):
    """El usuario canceló, o un paso privilegiado falló -- se corta la instalación, nunca se sigue a medias."""


def run_helper(operation: str, *, arg: str | None = None, stdin_data: str | None = None) -> dict:
    """
    Único punto de llamada al helper privilegiado -- SIEMPRE vía
    pkexec, SIEMPRE con el nombre exacto de una de las operaciones
    fijas (ver agent-install-helper, OPERATIONS). Nunca se arma un
    comando distinto ni se interpola nada acá.

    arg -- el único caso hoy es set_secret (el id del secret, nunca el
    valor). stdin_data -- el valor del secret en sí, cuando aplica.
    Hallazgo real (2026-09-20, diseñando secrets injection): el valor
    NUNCA viaja por argv -- /proc/<pid>/cmdline es legible por
    CUALQUIER usuario del sistema (no solo root), a diferencia de
    /proc/<pid>/environ (dueño del proceso o root). pkexec preserva el
    stdin del proceso que lo invoca hacia el programa de destino, así
    que esto llega al helper sin pasar por ningún archivo intermedio.
    """
    cmd = ["pkexec", HELPER, operation]
    if arg is not None:
        cmd.append(arg)
    proc = subprocess.run(
        cmd, input=stdin_data,
        capture_output=True, text=True,
    )
    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"código de salida {proc.returncode}"
        raise InstallAborted(f"{operation} falló: {detail}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise InstallAborted(f"{operation} devolvió una salida inesperada: {exc}") from exc


# --- pantallas de curses -----------------------------------------------

def draw_message(stdscr, title: str, lines: list[str], footer: str = "Presioná cualquier tecla para continuar...") -> None:
    """
    footer="" es la señal (ya usada por cada pantalla de progreso "Paso
    N/6") de que esto es un estado de "espere", no una pantalla que
    necesite una tecla -- bug real encontrado en QEMU (2026-09-15): acá
    se llamaba a stdscr.getch() incondicionalmente, así que cada
    pantalla de progreso se quedaba esperando una tecla que nadie iba a
    apretar, ANTES de siquiera invocar el paso real (run_helper nunca
    llegaba a ejecutarse). Ver docs/AGENT_INTERFACE.md.
    """
    stdscr.clear()
    stdscr.addstr(1, 2, title, curses.A_BOLD)
    for i, line in enumerate(lines):
        stdscr.addstr(3 + i, 2, line)
    if footer:
        stdscr.addstr(3 + len(lines) + 1, 2, footer, curses.A_DIM)
    stdscr.refresh()
    if footer:
        stdscr.getch()


def confirm(stdscr, title: str, lines: list[str]) -> bool:
    stdscr.clear()
    stdscr.addstr(1, 2, title, curses.A_BOLD)
    for i, line in enumerate(lines):
        stdscr.addstr(3 + i, 2, line)
    stdscr.addstr(3 + len(lines) + 1, 2, "[y] continuar    [n/Esc] cancelar", curses.A_DIM)
    stdscr.refresh()
    while True:
        ch = stdscr.getch()
        if ch in (ord("y"), ord("Y")):
            return True
        if ch in (ord("n"), ord("N"), 27):
            return False


def approve_capabilities(stdscr, agent_id: str, capabilities: list[str]) -> list[str]:
    """
    Aprobación explícita, una por una -- ver docs/AGENT_INTERFACE.md
    sección 2 ("Una capacidad es una declaración de intención del
    agente -- no una concesión automática"). Devuelve solo las
    aprobadas; el usuario puede rechazar capacidades individuales sin
    cancelar la instalación entera.
    """
    approved: list[str] = []
    for i, cap in enumerate(capabilities):
        stdscr.clear()
        stdscr.addstr(1, 2, f"Aprobación de capacidades -- {agent_id}", curses.A_BOLD)
        stdscr.addstr(3, 2, f"({i + 1}/{len(capabilities)}) ¿Otorgar esta capacidad?")
        stdscr.addstr(5, 4, cap, curses.A_BOLD | curses.A_REVERSE)
        stdscr.addstr(7, 2, "[y] otorgar    [n] denegar (el agente sigue instalándose sin ella)", curses.A_DIM)
        stdscr.refresh()
        while True:
            ch = stdscr.getch()
            if ch in (ord("y"), ord("Y")):
                approved.append(cap)
                break
            if ch in (ord("n"), ord("N")):
                break
    return approved


def _prompt_masked(stdscr, y: int, x: int) -> str:
    """
    Input de una línea con eco enmascarado ("*" por carácter) -- el
    valor real nunca se dibuja en pantalla. Enter confirma, Backspace
    borra, Esc deja el campo vacío (tratado como "no lo cargues" por
    collect_secrets para un secret opcional).
    """
    curses.curs_set(1)
    value = ""
    while True:
        stdscr.move(y, x)
        stdscr.clrtoeol()
        stdscr.addstr(y, x, "*" * len(value))
        stdscr.refresh()
        ch = stdscr.getch()
        if ch in (10, 13):  # Enter
            break
        if ch == 27:  # Esc
            value = ""
            break
        if ch in (curses.KEY_BACKSPACE, 127, 8):
            value = value[:-1]
        elif 32 <= ch <= 126:
            value += chr(ch)
    curses.curs_set(0)
    return value


def collect_secrets(stdscr, agent_id: str, secrets_declared: list[dict]) -> None:
    """
    Un secret por pantalla, valor enmascarado -- ver
    docs/AGENT_INTERFACE.md sección Secrets. Llama a set_secret por
    cada uno que el usuario cargue; uno opcional (required: false) que
    se deja vacío simplemente no se llama (el agente arranca sin él,
    mismo criterio que declarar la capability y no usarla). El valor
    viaja de esta pantalla a run_helper por argumento de función
    directo -- nunca queda en una variable de entorno ni en un archivo
    temporal de la TUI.
    """
    for entry in secrets_declared:
        secret_id = entry.get("id", "")
        required = bool(entry.get("required"))
        stdscr.clear()
        stdscr.addstr(1, 2, f"Secret requerido por {agent_id}", curses.A_BOLD)
        stdscr.addstr(3, 2, f"id:        {secret_id}")
        stdscr.addstr(4, 2, f"requerido: {'sí' if required else 'no'}")
        stdscr.addstr(6, 2, "Valor (Enter confirma, Esc deja vacío):")
        value = _prompt_masked(stdscr, 8, 4)
        if not value:
            if required:
                draw_message(
                    stdscr, "Secret requerido faltante",
                    [f"'{secret_id}' es obligatorio y quedó vacío.",
                     "El agente probablemente no va a arrancar sin él."],
                )
            continue
        run_helper("set_secret", arg=secret_id, stdin_data=value)


def check_existing_agent(stdscr) -> None:
    """
    Un solo agente activo a la vez (ver docs/AGENT_INTERFACE.md, fuera
    de alcance de v1) -- activate_agent ya lo hace cumplir de forma
    atómica (desactiva cualquier OTRO likay-agent-*.service antes de
    activar el nuevo), esta pantalla es solo para avisarle al usuario
    de antemano, no una acción en sí.
    """
    # --plain -- mismo hallazgo que ya se aplicó en op_activate_agent()
    # del helper (2026-09-20): sin esto, systemctl antepone un glifo "●"
    # para cualquier unidad en estado failed, y line.split()[0] agarra
    # ese glifo en vez del nombre real de la unidad.
    result = subprocess.run(
        ["systemctl", "list-units", "--type=service", "--plain", "--no-legend", "likay-agent-*.service"],
        capture_output=True, text=True,
    )
    existing = [
        u for line in result.stdout.splitlines()
        if (u := (line.split()[0] if line.split() else "")) and u not in INFRA_UNITS
    ]
    if existing:
        draw_message(
            stdscr, "Agente existente detectado",
            [f"Ya hay un agente activo: {existing[0]}",
             "Likay-OS soporta un solo agente activo a la vez.",
             "El agente existente se va a desactivar al confirmar la instalación."],
        )


def _reboot_or_show_fallback(stdscr) -> None:
    """
    Bug real encontrado en hardware físico (2026-09-17): antes de esto,
    las pantallas finales ("Instalación completa"/"Instalación
    cancelada") solo esperaban una tecla y el proceso terminaba ahí --
    el mensaje decía "reiniciá" pero nada lo hacía de verdad. Con
    Restart=no en likay-agent-install.service y tty1 sin getty mientras
    corría (Conflicts=getty@tty1.service, nunca restaurado al parar),
    la pantalla quedaba muerta -- el usuario tenía que apagar a la
    fuerza. `reboot` es la séptima operación fija del helper (ver
    agent-install-helper, OPERATIONS) -- si por lo que sea falla, se
    muestra un mensaje final en vez de dejar la pantalla en silencio
    sin ninguna explicación.
    """
    try:
        run_helper("reboot")
    except InstallAborted as exc:
        # footer NO vacío a propósito -- a diferencia de las pantallas
        # de progreso "Paso N/6" (que nunca deben esperar tecla, ver el
        # docstring de draw_message), acá SÍ hace falta bloquear: es la
        # última pantalla posible, el usuario tiene que leer que el
        # reinicio automático falló antes de que curses.wrapper()
        # limpie la terminal al salir.
        draw_message(
            stdscr, "No se pudo reiniciar automáticamente",
            [str(exc), "Apagá el equipo manualmente para continuar."],
            footer="Presioná cualquier tecla para salir...",
        )


def main(stdscr) -> int:
    curses.curs_set(0)

    if not confirm(
        stdscr, "Instalador de agentes de Likay-OS",
        ["Vas a instalar un agente de terceros sobre este sistema.",
         "El transporte (USB) no es una frontera de seguridad -- la",
         "seguridad viene del manifiesto validado, tu aprobación",
         "explícita de capacidades, y el sandbox del sistema."],
    ):
        return 1

    try:
        draw_message(stdscr, "Paso 1/6", ["Montando la partición likay-agent y el bundle USB..."], footer="")
        run_helper("mount_bundle")

        manifest = run_helper("validate_manifest")
        agent_id = manifest["agent_id"]
        short_id = manifest["short_id"]
        capabilities = manifest["capabilities"]
        runtime = manifest.get("runtime") or {}
        secrets_declared = manifest.get("secrets") or []

        if not confirm(
            stdscr, f"Manifiesto validado: {agent_id}",
            [f"id:        {agent_id}",
             f"puerto:    {runtime.get('port', '(no es un servicio)')}",
             f"capacidades pedidas: {len(capabilities)}",
             "", "¿Continuar con la instalación?"],
        ):
            return 1

        approved = approve_capabilities(stdscr, agent_id, capabilities)

        check_existing_agent(stdscr)

        if not confirm(stdscr, "Confirmación final", [
            f"Se va a instalar '{agent_id}' con {len(approved)} capacidad(es) aprobada(s).",
            "Esto va a crear un usuario de sistema dedicado y un",
            "servicio systemd sandboxeado. ¿Confirmás?",
        ]):
            return 1

        draw_message(stdscr, "Paso 2/6", ["Creando el usuario Linux dedicado del agente..."], footer="")
        created = run_helper("create_agent")
        linux_user = created["linux_user"]

        # Después de create_agent, no antes -- set_secret necesita el
        # usuario dedicado ya creado (para el chown, y para el Podman
        # secret rootless si runtime.type: oci). Antes de Paso 3/6 (que
        # ya puede tardar minutos con load_oci_image) para no hacer
        # esperar al usuario innecesariamente antes de pedirle algo.
        if secrets_declared:
            collect_secrets(stdscr, agent_id, secrets_declared)

        # Hallazgo real (2026-09-20, probando en hardware real): este
        # paso llamaba a install_bundle sin importar runtime.type --
        # install_bundle es SOLO para python (rechaza oci explícito, ver
        # su docstring en el helper) y load_oci_image nunca se llamaba
        # acá, así que instalar cualquier agente OCI real por el TUI
        # (no por el helper a mano, como se probó todo Fase C en QEMU)
        # fallaba siempre en este paso. Nunca se había ejercitado el
        # flujo completo del TUI real contra un manifiesto oci hasta
        # esta prueba en hardware.
        runtime_type = runtime.get("type")
        if runtime_type == "oci":
            draw_message(stdscr, "Paso 3/6", ["Cargando la imagen OCI ya transportada...",
                                                "(esto puede tardar unos minutos)"], footer="")
            run_helper("load_oci_image")
        else:
            draw_message(stdscr, "Paso 3/6", ["Copiando el código e instalando dependencias...",
                                                "(esto puede tardar unos minutos)"], footer="")
            run_helper("install_bundle")

        draw_message(stdscr, "Paso 4/6", ["Generando la unidad systemd sandboxeada..."], footer="")
        run_helper("generate_unit")

        draw_message(stdscr, "Paso 5/6", ["Registrando las capacidades aprobadas en el Broker..."], footer="")
        try:
            register_policy(agent_id=agent_id, linux_user=linux_user, capabilities=approved)
        except BrokerClientError as exc:
            raise InstallAborted(f"no se pudo registrar la política en el Broker: {exc}") from exc

        draw_message(stdscr, "Paso 6/6", ["Activando el servicio del agente..."], footer="")
        activated = run_helper("activate_agent")

        # Hallazgo real (2026-09-17): el helper ya hace userdel del
        # usuario Linux de cualquier agente viejo que haya desactivado
        # (v1 soporta uno solo activo a la vez), pero solo el Broker en
        # sí puede tocar su propio policy.json -- remove_grant() existía
        # sin ningún caller. Best-effort a propósito: el agente NUEVO ya
        # quedó activo y funcionando en el paso de arriba; que no se
        # pueda limpiar el grant HUÉRFANO de uno viejo no es motivo para
        # abortar una instalación que, por lo demás, ya terminó bien.
        for old_linux_user in activated.get("deactivated_linux_users", []):
            try:
                unregister_policy(linux_user=old_linux_user)
            except BrokerClientError:
                pass

        # activate_agent (helper, como root) ya escribió
        # /etc/likay-os/active-agent.conf -- esta TUI corre sin
        # privilegios y NO puede escribir en /etc directamente (bug
        # real encontrado en QEMU 2026-09-16: un PermissionError acá
        # tumbaba el proceso entero con el agente ya activado, dejando
        # la pantalla congelada en "Paso 6/6" sin ningún mensaje).

        draw_message(
            stdscr, "Instalación completa",
            [f"'{agent_id}' está instalado y activo como {linux_user}.",
             "Reiniciando para volver al modo kiosco normal..."],
            footer="Presioná cualquier tecla para reiniciar...",
        )
        _reboot_or_show_fallback(stdscr)
        return 0

    except InstallAborted as exc:
        draw_message(stdscr, "Instalación cancelada", [str(exc)], footer="Presioná cualquier tecla para reiniciar...")
        _reboot_or_show_fallback(stdscr)
        return 1


if __name__ == "__main__":
    raise SystemExit(curses.wrapper(main))
