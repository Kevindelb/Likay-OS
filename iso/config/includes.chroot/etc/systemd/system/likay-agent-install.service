[Unit]
Description=Likay-OS -- instalador de agentes de terceros (TUI, ver docs/AGENT_INTERFACE.md)
# Único gate para entrar en este modo: un parámetro de kernel elegido a
# mano en el menú de GRUB del disco YA instalado (ver
# etc/grub.d/41_likay_agent_install), nunca algo disparable desde una
# sesión de kiosk ya corriendo -- mismo criterio que
# likay-installer.service para likay.mode=installer.
ConditionKernelCommandLine=likay.mode=agent-install
After=systemd-user-sessions.service getty@tty1.service likay-agent-broker.service
Wants=likay-agent-broker.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Usuario de sistema ESTÁTICO, sin privilegios -- el TUI NUNCA corre
# como root ni como kiosk (ver docs/AGENT_INTERFACE.md, decisión
# explícita). Los pasos que sí necesitan root pasan por
# agent-install-helper vía pkexec, nunca por este proceso directo.
User=likay-agent-install
Group=likay-agent-install
PAMName=login
TTYPath=/dev/tty1
# StandardOutput=tty (NO journal+console) -- segundo bug real, mismo
# síntoma que el de TERM de abajo pero causa distinta (2026-09-15):
# journal+console multiplexa stdout hacia /dev/console + el journal, no
# da un file descriptor crudo de terminal -- curses necesita hacer
# ioctls de verdad (tcsetattr, etc.) sobre EL MISMO dispositivo que usa
# para stdin, y journal+console no sirve para eso. Con TTYPath=/dev/tty1
# + StandardInput=tty + StandardOutput=tty, entrada y salida son el
# mismo fd real de /dev/tty1 -- lo que curses.wrapper() necesita.
# likay-installer.service/likay-kiosk.service SÍ pueden usar
# journal+console porque Xorg/cage manejan su propio acceso a
# VT/DRM directo, nunca a través de stdout -- este es el primer
# servicio del proyecto donde el programa en sí (no algo que lanza)
# necesita que stdin/stdout SEAN la terminal.
StandardInput=tty
StandardOutput=tty
# StandardError sigue en journal+console (no tty) a propósito: un
# traceback de Python mezclado con el dibujado de curses en la misma
# tty sería ilegible -- separado, sigue siendo visible por consola
# serie/journalctl para debug, sin romper la UI real.
StandardError=journal+console
# Ver el commit anterior: sin esto, curses.wrapper() fallaba con
# "_curses.error: cbreak() returned ERR" porque ncurses no encontraba
# terminfo para $TERM sin setear. "linux" es el valor correcto para
# una VT de consola Linux de verdad (tty1).
Environment=TERM=linux
ExecStart=/usr/lib/likay/agent-install-launcher
Restart=no

# NoNewPrivileges NO se pone a propósito -- mismo motivo exacto que
# likay-installer.service (ver ese archivo): prctl(PR_SET_NO_NEW_PRIVS)
# se hereda a TODO proceso hijo y no se puede revertir, así que también
# anula el bit setuid de pkexec para los hijos de este proceso -- ya lo
# probamos en QEMU con DynamicUser=yes (que fuerza esto sin avisar) y
# colgó "pkexec calamares" en silencio para siempre. Este servicio
# necesita invocar "pkexec agent-install-helper" -- ponerlo acá
# reproduciría exactamente ese mismo bug ya encontrado y corregido una
# vez, para el instalador.

[Install]
WantedBy=multi-user.target
