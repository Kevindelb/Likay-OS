[Unit]
Description=Likay-OS -- instalador de agentes de terceros (TUI, ver docs/AGENT_INTERFACE.md)
# Único gate para entrar en este modo: un parámetro de kernel elegido a
# mano en el menú de GRUB del disco YA instalado (ver
# etc/grub.d/41_likay_agent_install), nunca algo disparable desde una
# sesión de kiosk ya corriendo -- mismo criterio que
# likay-installer.service para likay.mode=installer.
ConditionKernelCommandLine=likay.mode=agent-install
After=systemd-user-sessions.service getty@tty1.service likay-agent-broker.service
Wants=likay-agent-broker.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Usuario de sistema ESTÁTICO, sin privilegios -- el TUI NUNCA corre
# como root ni como kiosk (ver docs/AGENT_INTERFACE.md, decisión
# explícita). Los pasos que sí necesitan root pasan por
# agent-install-helper vía pkexec, nunca por este proceso directo.
User=likay-agent-install
Group=likay-agent-install
PAMName=login
# El instalador es un TUI real: el proceso principal necesita trabajar
# directamente sobre la VT, a diferencia de likay-installer.service/
# likay-kiosk.service, donde Xorg/cage manejan su propio acceso a
# VT/DRM y nunca consumen stdin/stdout para su UI -- por eso esos dos
# sí pueden usar journal+console sin problema, y este no.
#
# Segundo bug real, mismo síntoma que el de TERM de abajo pero causa
# distinta (2026-09-15): con StandardOutput=journal+console (como en
# los demás servicios), curses.wrapper() fallaba con "_curses.error:
# cbreak() returned ERR" -- journal+console multiplexa stdout hacia
# /dev/console + el journal, no da un descriptor de terminal crudo.
# StandardInput=tty y StandardOutput=tty conectan la entrada y salida
# estándar del proceso al TTY que indica TTYPath -- necesario porque
# curses.wrapper() opera directamente sobre esa terminal.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
# StandardError SOLO en journal, sin "+console" -- a diferencia de
# stdout, /dev/console puede terminar siendo la misma VT donde corre
# curses (tty1 acá), así que "+console" reintroduciría el problema que
# se busca evitar: un traceback de Python escrito encima de la UI ya
# dibujada. Para debug: journalctl -u likay-agent-install.service.
StandardError=journal
# Sin esto, curses.wrapper() fallaba con "_curses.error: cbreak()
# returned ERR" porque ncurses no encontraba terminfo para $TERM sin
# setear. "linux" es el valor correcto para una VT de consola Linux de
# verdad (tty1).
Environment=TERM=linux
ExecStart=/usr/lib/likay/agent-install-launcher
Restart=no

# NoNewPrivileges NO se pone a propósito -- mismo motivo exacto que
# likay-installer.service (ver ese archivo): prctl(PR_SET_NO_NEW_PRIVS)
# se hereda a TODO proceso hijo y no se puede revertir, así que también
# anula el bit setuid de pkexec para los hijos de este proceso -- ya lo
# probamos en QEMU con DynamicUser=yes (que fuerza esto sin avisar) y
# colgó "pkexec calamares" en silencio para siempre. Este servicio
# necesita invocar "pkexec agent-install-helper" -- ponerlo acá
# reproduciría exactamente ese mismo bug ya encontrado y corregido una
# vez, para el instalador.

[Install]
WantedBy=multi-user.target
