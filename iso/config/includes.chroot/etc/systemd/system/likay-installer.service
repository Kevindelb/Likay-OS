[Unit]
Description=Likay-OS installer (Xorg + Calamares)
# Único gate para entrar en modo instalador: un parámetro de kernel
# elegido a mano en el menú de arranque (ver
# config/bootloaders/isolinux/install.cfg.in), nunca algo disparable
# desde una sesión de kiosk ya corriendo. En un boot normal
# (likay-kiosk.service) esta condición es falsa y el servicio se
# saltea (Skipped, no Failed) -- kiosk y el instalador nunca coexisten
# en el mismo arranque. Ver docs/ROADMAP.md, Etapa 2.
ConditionKernelCommandLine=likay.mode=installer
# tty1, no tty2: probado en QEMU (2026-09-14) -- Xorg.wrap rechaza
# arrancar ("Only console users are allowed to run the X server") si
# la sesión no está en la VT ACTIVA, y nada activa tty2 solo con
# TTYPath/PAMName=login (el kernel deja tty1 activa por default).
# Usar la misma tty1 que likay-kiosk.service no genera conflicto real:
# por la ConditionKernelCommandLine de ambos servicios, nunca corren
# en el mismo arranque -- ver docs/ROADMAP.md, Etapa 2.
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
# Usuario de sistema ESTÁTICO (creado por 0420-setup-installer.chroot,
# useradd -r -s /bin/bash), NO DynamicUser=yes -- probado en QEMU
# (2026-09-14) y descartado a propósito: la documentación de systemd
# (systemd.exec(5), DynamicUser=) dice explícito que DynamicUser=yes
# fuerza NoNewPrivileges=yes de forma NO desactivable ("cannot be
# disabled"), y además un /tmp privado salvo que se pida lo contrario.
# Las dos cosas rompen este servicio en silencio: pkexec no puede
# escalar a root bajo NoNewPrivileges (el arranque se cuelga
# indefinidamente en "pkexec calamares", sin ningún error visible), y
# aunque pudiera, el root de pkexec no vería el socket de Xorg en un
# /tmp aislado del de este servicio. /etc/polkit-1/rules.d/
# 60-likay-installer.rules autoriza a ESTE usuario específico (no a
# kiosk) para correr Calamares como root -- ver ese archivo para el
# razonamiento completo de por qué un usuario dedicado alcanza sin
# necesidad de DynamicUser.
User=likay-installer
Group=likay-installer
# PAMName=login + grupos video/input/render (ver el hook): mismo
# mecanismo que ya usa likay-kiosk.service para los permisos "uaccess"
# sobre DRM/input que Xorg necesita para hablarle al hardware directo,
# sin un seatd separado.
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal+console
StandardError=journal+console
# NoNewPrivileges NO se pone a propósito, a diferencia de casi
# cualquier otro .service de este proyecto: el propósito entero de
# este servicio es escalar a root vía pkexec/Polkit, y NoNewPrivileges
# se lo bloquea a nivel de kernel. No "arreglar" esto agregándolo (y
# no usar DynamicUser=yes, que lo fuerza igual sin avisar -- ver arriba).
ExecStart=/usr/lib/likay/installer-launcher
Restart=no

[Install]
WantedBy=multi-user.target
