[Unit]
Description=kal-in backend (uvicorn / agent_core.orchestrator) — agente de referencia sobre el kernel kal
After=network.target ollama.service
Wants=ollama.service
# Encontrado probando likay-installer.service en QEMU (2026-09-14):
# esto arrancaba igual en modo instalador, sin ninguna razón para
# estar corriendo ahí (Calamares no lo necesita, y es superficie
# innecesaria mientras hay acceso privilegiado al disco de por medio).
# Mismo mecanismo que likay-kiosk.service.
#
# likay.privileged, no "!likay.mode=installer" a secas -- mismo bug
# real encontrado en QEMU (2026-09-15) con likay.mode=agent-install:
# ver el comentario largo en likay-kiosk.service para el porqué exacto
# (systemd ORea condiciones repetidas del mismo tipo, dos negaciones
# distintas no dan AND). Ver docs/ROADMAP.md, Etapa 2 /
# docs/AGENT_INTERFACE.md.
ConditionKernelCommandLine=!likay.privileged
# Variante bare (LIKAY_BARE_KAL_IN=1, ver iso/auto/build): /opt/kal-in
# no existe, así que ni el venv ni el ExecStart de abajo tienen nada
# para correr. Sin esto, likay-kiosk.service's Wants=kal-in-backend.service
# (ver el comentario ahí sobre por qué un Wants= arranca la unidad SIN
# IMPORTAR su enable/disable) lo dispararía igual en cada boot, crasheando
# en loop cada RestartSec por un venv que nunca se instaló -- un
# ConditionPathExists=/ruta falla en "skipped", instantáneo, sin el
# problema de espera de dispositivo que sí tienen los ConditionKernelCommandLine=
# combinados con mounts (ver [[systemd-mount-pull-not-condition]]) --
# acá no hay ningún .device de por medio, es un chequeo de archivo llano.
ConditionPathExists=/opt/kal-in/.venv/bin/uvicorn

[Service]
Type=simple
User=kal-in
Group=kal-in
WorkingDirectory=/opt/kal-in
Environment=AGENT_ENV=production
# --host 127.0.0.1, NO 0.0.0.0 como el Dockerfile de kal-in: ahí la
# restricción a loopback la hace el mapeo de puertos de Docker
# (docker-compose.yml: "127.0.0.1:8000:8000"). Acá no hay esa capa —
# bindear 0.0.0.0 en un live-boot expondría la API del agente (incluido
# /self-modification/apply, protegido solo por el token admin como
# segunda capa) a toda la LAN. Ver el hallazgo de seguridad documentado
# en vendor/kal-in/utils/admin_token.py (2026-07-09).
ExecStart=/opt/kal-in/.venv/bin/uvicorn agent_core.orchestrator:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2
# Por default systemd solo manda esto al journal — sin acceso a
# persistencia ni journalctl interactivo en la VM de prueba, no se veía
# nada de por qué esto no respondía. journal+console (mismo patrón que
# likay-kiosk.service) lo saca por la consola/serial.
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
