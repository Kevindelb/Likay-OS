# Monta la partición likay-agent (creada por Calamares, ver
# 0440-configure-calamares-partitioning.chroot -- a propósito SIN
# mountPoint en fstab, reservada para el mecanismo de "montar
# cualquier agente") en /mnt/likay-agent.
#
# Bug real encontrado en QEMU (2026-09-16): op_mount_bundle() en
# agent-install-helper monta esta partición, pero solo durante la
# sesión de instalación -- nunca quedaba como mount persistente. Un
# agente ya instalado (con su venv/src/data bajo
# /mnt/likay-agent/<short_id>/) fallaba en CADA arranque normal de
# kiosco con "Failed to set up mount namespacing:
# /mnt/likay-agent/<short_id>/data: No such file or directory" /
# "226/NAMESPACE".
#
# SEGUNDO bug real, encontrado arreglando el primero: habilitarlo
# incondicionalmente vía [Install] WantedBy=local-fs.target colgaba
# CADA arranque del medio live ~90s esperando el .device (que ahí
# nunca existe) -- ConditionKernelCommandLine=!boot=casper NO alcanzó
# para evitarlo: local-fs.target ya tira de la dependencia del
# .device ANTES de que la Condition de esta unidad se evalúe, así que
# la espera pasa igual aunque la unidad termine "skipped".
#
# Fix real: esta unidad NO se habilita en ningún arranque. En cambio,
# cada unidad de agente generada (ver _systemd_unit_text en
# agent-install-helper) declara RequiresMountsFor=/mnt/likay-agent/<id>
# -- systemd resuelve sola qué .mount cubre esa ruta (esta) y la monta
# bajo demanda, SOLO cuando un agente de verdad la necesita. En el
# medio live no existe ningún likay-agent-*.service, así que esta
# unidad nunca se pide y nunca espera nada. mount_bundle() en el
# helper la sigue montando a mano durante la instalación (con su
# propio os.path.ismount() de por medio, sin conflicto).
[Unit]
Description=Likay-OS -- partición likay-agent (agentes de terceros instalados)
DefaultDependencies=no

[Mount]
What=/dev/disk/by-label/likay-agent
Where=/mnt/likay-agent
Type=ext4
Options=defaults,nofail
