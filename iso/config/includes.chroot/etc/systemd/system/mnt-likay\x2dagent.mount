# Monta la partición likay-agent (creada por Calamares, ver
# 0440-configure-calamares-partitioning.chroot -- a propósito SIN
# mountPoint en fstab, reservada para el mecanismo de "montar
# cualquier agente") en /mnt/likay-agent en TODO arranque, no solo en
# likay.mode=agent-install.
#
# Bug real encontrado en QEMU (2026-09-16): op_mount_bundle() en
# agent-install-helper monta esta partición, pero solo durante la
# sesión de instalación -- nunca queda como mount persistente. Un
# agente ya instalado (con su venv/src/data bajo
# /mnt/likay-agent/<short_id>/) fallaba en CADA arranque normal de
# kiosco con "Failed to set up mount namespacing:
# /mnt/likay-agent/<short_id>/data: No such file or directory" /
# "226/NAMESPACE", porque ReadWritePaths= (ver _systemd_unit_text en
# el helper) apunta a una ruta que, sin este mount, simplemente no
# existe en un arranque nuevo.
#
# ConditionKernelCommandLine=!boot=casper -- segundo bug real,
# encontrado apenas arriba en QEMU (2026-09-16): "nofail" evita que la
# FALLA del mount bloquee el arranque, pero NO evita la espera de
# hasta 90s por el .device que nunca va a aparecer en el medio live
# (que jamás tiene esta partición) -- cada boot del live quedaba
# colgado ~90s en "Job dev-disk-by\x2dlabel-likay\x2dagent...".
# boot=casper está SIEMPRE presente en el cmdline del live (confirmado
# en serial), NUNCA en un disco ya instalado -- distingue los dos
# casos de forma confiable sin tocar nada del lado de casper.
#
# DefaultDependencies=no + Before=local-fs.target: mismo patrón que
# cualquier .mount que necesite estar listo temprano, antes de que
# local-fs.target (del que dependen los .service de agentes vía la
# cadena normal de arranque) se considere alcanzado.
[Unit]
Description=Likay-OS -- partición likay-agent (agentes de terceros instalados)
DefaultDependencies=no
Before=local-fs.target
ConditionKernelCommandLine=!boot=casper

[Mount]
What=/dev/disk/by-label/likay-agent
Where=/mnt/likay-agent
Type=ext4
Options=defaults,nofail

[Install]
WantedBy=local-fs.target
