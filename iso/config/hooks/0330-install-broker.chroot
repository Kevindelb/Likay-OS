#!/bin/bash
# Instala el Likay Agent Broker desde /opt/likay-broker (código
# copiado ahí por auto/build, host, antes de `lb build` -- ver ese
# script), mismo patrón exacto que 0300-install-kal.chroot/
# 0320-install-kal-in.chroot, para el Broker en vez de un agente.
#
# Ver docs/AGENT_INTERFACE.md para qué es el Broker -- V1 de la
# interfaz genérica de "montar cualquier agente" (issue #2, Fase 2).
set -euo pipefail

# Idempotente, mismo motivo que 0300/0320.
if ! id likay-broker >/dev/null 2>&1; then
    useradd -r -m -d /opt/likay-broker-home -s /bin/false likay-broker
fi

python3 -m venv /opt/likay-broker/.venv
/opt/likay-broker/.venv/bin/pip install --no-cache-dir --upgrade pip
# Hallazgo de la auditoría de seguridad (2026-09-26, B-A2): antes de
# este fix, "pip install -e ." resolvía pyyaml/jsonschema (y sus
# transitivas) sin hashes ni versiones fijas -- una release maliciosa
# de cualquiera de esas dependencias, publicada entre un build y el
# siguiente, quedaba horneada e importada en runtime sin que nada lo
# notara. requirements-broker.lock.txt (generado con
# "uv pip compile broker/pyproject.toml --generate-hashes") fija
# versión Y hash de cada dependencia de terceros -- --require-hashes
# rechaza instalar cualquier paquete que no matchee exactamente.
#
# --require-hashes es incompatible con "-e" (un install editable no
# tiene un hash posible, es una ruta local) -- por eso las
# dependencias de terceros y el propio paquete se instalan en dos
# pasos separados: primero las hasheadas, después likay-broker mismo
# (código de este repo, ya confiable por estar en el árbol de fuentes
# que se audita/revisa -- el hash-pinning importa para la cadena de
# suministro DE TERCEROS, no para el propio código).
/opt/likay-broker/.venv/bin/pip install --no-cache-dir --require-hashes \
    -r /opt/likay-broker/requirements-broker.lock.txt
/opt/likay-broker/.venv/bin/pip install --no-cache-dir --no-deps /opt/likay-broker

# policy.json y audit.log viven fuera de /opt/likay-broker a propósito
# (/var/lib, /var/log -- convención estándar de estado runtime vs.
# código de la aplicación), pero se crean acá para que el directorio
# ya exista con el dueño correcto antes del primer arranque del
# servicio -- ver likay_broker/policy_store.py y audit.py, que de
# todos modos crean el directorio si falta (mkdir(parents=True,
# exist_ok=True)), esto es solo para que el dueño sea correcto desde
# el vamos.
mkdir -p /var/lib/likay-agent-broker /var/log/likay-agent-broker
# Hallazgo de la auditoría de seguridad (2026-09-26): antes este chown -R
# incluía /opt/likay-broker, o sea que el usuario SIN privilegios
# likay-broker quedaba dueño de su propio código Y de su intérprete
# (/opt/likay-broker/.venv/bin/python3). Ese árbol lo ejecuta el helper
# de instalación COMO ROOT (su shebang apunta al venv del Broker) y
# también la TUI como likay-agent-install, que tiene pkexec sin
# contraseña: cualquier escritura lograda como likay-broker se convertía
# en ejecución como root. Nada ejecutado por root debe ser escribible por
# un usuario sin privilegios.
#
# El Broker solo necesita escribir estado runtime y log (ver
# ReadWritePaths= en likay-agent-broker.service); el código y el venv
# quedan root:root. `chown -R root:root` es necesario (no solo dejarlo
# como está) porque chroot/ se conserva entre builds y una corrida
# anterior pudo haberlos dejado con el dueño viejo.
chown -R root:root /opt/likay-broker
chmod -R go-w /opt/likay-broker
chown -R likay-broker:likay-broker /opt/likay-broker-home \
    /var/lib/likay-agent-broker /var/log/likay-agent-broker

# Bug real encontrado probando esto en QEMU (2026-09-15): faltaba este
# systemctl enable -- la unidad tenía WantedBy=multi-user.target en su
# [Install], pero includes.chroot no habilita nada solo (mismo motivo
# que 0420-setup-installer.chroot/0320-install-kal-in.chroot lo hacen
# a mano). Sin esto, likay-agent-broker.service nunca corría, y
# `likay_agent_install.service`/register_policy hubieran fallado en
# silencio al no encontrar el socket.
systemctl enable likay-agent-broker.service

# Auditoría 2026-09-26: el timer que verifica la cadena de auditoría
# (ver likay-agent-broker-verify.timer). Mismo motivo que el enable de
# arriba -- includes.chroot no habilita nada solo.
systemctl enable likay-agent-broker-verify.timer
