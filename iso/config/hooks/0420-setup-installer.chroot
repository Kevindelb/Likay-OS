#!/bin/bash
set -euo pipefail

# Usuario de sistema ESTÁTICO para likay-installer.service — NO
# DynamicUser=yes (probado en QEMU el 2026-09-14 y descartado: fuerza
# NoNewPrivileges=yes de forma no desactivable, lo que cuelga
# "pkexec calamares" en silencio para siempre — ver el comentario en
# likay-installer.service). Mismo patrón que 0400-setup-kiosk.chroot:
# grupos video/input/render para que Xorg pueda hablarle a DRM/input
# directo. Sin grupos administrativos, sin sudo, sin password (useradd
# -r deja el password bloqueado por default) — igual que kal/kal-in.
if ! id likay-installer >/dev/null 2>&1; then
    useradd -r -m -d /home/likay-installer -s /bin/bash -G video,input,render likay-installer
fi

# Instalador de Etapa 2 (ver docs/ROADMAP.md) — likay-installer.service
# solo arranca si el kernel command line trae likay.mode=installer
# (ver config/bootloaders/isolinux/install.cfg.in), así que habilitarlo
# acá no lo hace correr en un boot normal de kiosco. `systemctl enable`
# solo escribe los symlinks de [Install] — no hace falta un systemd
# corriendo de verdad dentro del chroot para esto (mismo motivo que
# 0400-setup-kiosk.chroot).
chmod 0755 /usr/lib/likay/installer-launcher

systemctl enable likay-installer.service
