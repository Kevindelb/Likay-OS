#!/bin/bash
# Instala kal desde /opt/kal (código copiado ahí por auto/build, host,
# antes de `lb build` — ver ese script) usando SOLO requirements-core.txt
# + requirements-dev.txt, sin requirements-multimodal.txt (diffusers/torch
# pesan varios GB y esta etapa no necesita generación de imagen/audio/video
# — ver docs/ROADMAP.md, Etapa 1).
set -euo pipefail

# Idempotente: este hook puede correr más de una vez sobre el mismo
# chroot persistente entre iteraciones de desarrollo (ver auto/build /
# model-cache) — useradd sin este chequeo falla en seco si el usuario ya
# existe de una corrida anterior.
if ! id kal >/dev/null 2>&1; then
    useradd -r -m -d /opt/kal-home -s /bin/false kal
fi

python3 -m venv /opt/kal/.venv
/opt/kal/.venv/bin/pip install --no-cache-dir --upgrade pip
# Hallazgo de la auditoría de seguridad (2026-09-26, B-A2): antes de
# este fix, esto resolvía las dependencias de kal (requirements-core.txt/
# requirements-dev.txt, con ">=" sin techo) sin hashes -- una release
# maliciosa de cualquier transitiva, publicada entre un build y el
# siguiente, quedaba horneada sin que nada lo notara. kal.lock.txt
# (auto/build lo copia acá desde iso/pip-locks/kal.lock.txt, generado
# con "uv pip compile ... --generate-hashes") fija versión Y hash de
# cada paquete -- --require-hashes rechaza cualquiera que no matchee.
/opt/kal/.venv/bin/pip install --no-cache-dir --require-hashes -r /opt/kal/kal.lock.txt

# data/ (memoria, admin_token, claves de firma) tiene que ser escribible
# en runtime por el usuario "kal" — en el live system esto vive en la capa
# overlay en RAM, así que no persiste entre arranques (esperado en esta
# etapa: ver docs/ROADMAP.md, "nada de instalación persistente todavía").
mkdir -p /opt/kal/data
chown -R kal:kal /opt/kal /opt/kal-home
