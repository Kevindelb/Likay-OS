#!/bin/bash
# Instala kal-in desde /opt/kal-in (código copiado ahí por auto/build,
# host, antes de `lb build` — ver ese script), usando SOLO
# requirements-core.txt, sin requirements-multimodal.txt (diffusers/torch
# pesan varios GB y esta etapa no necesita generación de imagen/audio/video
# — ver docs/ROADMAP.md, Etapa 1) ni requirements-dev.txt (pytest/ruff no
# hacen falta en runtime -- hallazgo B-M3, auditoría 2026-09-26). Mismo
# patrón exacto que 0300-install-kal.chroot, para el agente en vez del
# kernel.
#
# Fase 1 del issue #2 ("montar cualquier agente"): kal-in vendorizado y
# conectado a mano, todavía no hay una interfaz genérica — eso queda
# para cuando aparezca un segundo agente real que la justifique.
set -euo pipefail

# Variante bare (LIKAY_BARE_KAL_IN=1, ver auto/build — único punto de
# decisión): /opt/kal-in directamente no existe, porque auto/build
# saltó el rsync que normalmente lo copia ahí. Este chequeo no es una
# segunda decisión independiente, es leer la consecuencia mecánica de
# la que ya se tomó en auto/build.
if [ ! -f /opt/kal-in/requirements-core.txt ]; then
    echo "==> /opt/kal-in no existe (variante bare) — saltando instalación de kal-in"
    exit 0
fi

# Idempotente, mismo motivo que 0300-install-kal.chroot.
if ! id kal-in >/dev/null 2>&1; then
    useradd -r -m -d /opt/kal-in-home -s /bin/false kal-in
fi

python3 -m venv /opt/kal-in/.venv
/opt/kal-in/.venv/bin/pip install --no-cache-dir --upgrade pip
# Mismo motivo que 0300-install-kal.chroot (auditoría 2026-09-26, B-A2):
# kal-in.lock.txt fija versión+hash de cada dependencia de terceros.
/opt/kal-in/.venv/bin/pip install --no-cache-dir --require-hashes -r /opt/kal-in/kal-in.lock.txt

# data/ (memoria, admin_token, claves de firma) tiene que ser escribible
# en runtime por el usuario "kal-in" — en el live system esto vive en la
# capa overlay en RAM, así que no persiste entre arranques (esperado en
# esta etapa: ver docs/ROADMAP.md, "nada de instalación persistente
# todavía").
mkdir -p /opt/kal-in/data
chown -R kal-in:kal-in /opt/kal-in /opt/kal-in-home
