#!/bin/bash
set -euo pipefail

# Hallazgo de la auditoría de seguridad (2026-09-26, B-M4): users.conf
# vendorizado (calamares-settings-debian) trae minLength: 6 sin ningún
# requisito de complejidad -- una contraseña de 6 caracteres cualquiera
# es débil para la cuenta que Calamares crea con `sudoersGroup: sudo`
# (login local, pero igual la única barrera antes de un `sudo su -`).
#
# No se puede editar iso/config/includes.chroot/etc/calamares/modules/
# users.conf directo -- auto/build rsyncea vendor/calamares-settings-debian/
# calamares/ ahí CON --delete en cada build, así que cualquier edición
# manual se pierde en la siguiente corrida (mismo gotcha ya documentado
# para branding.desc/partition.conf -- ver 0440/0470/0480). Este hook
# corre DESPUÉS de ese rsync (orden numérico), mismo patrón.
#
# Alcance deliberadamente acotado: solo sube minLength (6 -> 12, umbral
# que sugiere la propia auditoría). NO se toca defaultGroups (sacar
# "sudo" de ahí es una decisión de producto/UX -- cómo el usuario
# administraría el sistema sin sudo -- no algo para decidir a ciegas
# en un fix de auditoría) ni se agregan reglas de complejidad (el
# módulo "users" de Calamares -- ver su código real, no documentación
# de terceros -- no expone un campo para eso en users.conf; forzarlo
# necesitaría un módulo/hook de Calamares distinto, fuera de alcance
# de un cambio de config).
USERS_CONF=/etc/calamares/modules/users.conf

if ! [ -f "${USERS_CONF}" ]; then
    echo "0490: no existe ${USERS_CONF} -- ¿corrió el rsync de vendor/calamares-settings-debian en auto/build?" >&2
    exit 1
fi

if ! grep -qE '^\s*minLength:\s*6\s*#' "${USERS_CONF}"; then
    if grep -qE '^\s*minLength:\s*12\s*#' "${USERS_CONF}"; then
        echo "0490: minLength ya estaba en 12 (build anterior sobre el mismo chroot) -- nada que hacer."
        exit 0
    fi
    echo "0490: users.conf vendorizado no tiene la línea 'minLength: 6 # ...' esperada -- el formato cambió upstream, revisar a mano antes de editar." >&2
    exit 1
fi

sed -i -E 's/^(\s*minLength:\s*)6(\s*#.*)$/\112\2/' "${USERS_CONF}"
grep -qE '^\s*minLength:\s*12\s*#' "${USERS_CONF}"
echo "0490: minLength subido de 6 a 12 en users.conf."
