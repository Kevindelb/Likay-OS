#!/bin/bash
set -euo pipefail

# Idempotente, mismo motivo que 0300-install-kal.chroot.
if ! id kiosk >/dev/null 2>&1; then
    useradd -r -m -d /home/kiosk -s /bin/bash -G video,input,render kiosk
fi

chmod 0755 /usr/local/bin/likay-kiosk-start

chmod 0755 /opt/likay/smoke-test/app.py

# `systemctl enable` acá solo escribe los symlinks de [Install] — no hace
# falta un systemd corriendo de verdad dentro del chroot para esto.
# ollama.service condicional: solo existe si el hook 0100 instaló Ollama
# de verdad (algunos builds de prueba lo sacan a propósito).
if [ -e /etc/systemd/system/ollama.service ]; then
    systemctl enable ollama.service
fi

# kal-in-backend.service reemplaza a likay-smoke-test.service en :8000
# (Fase 1 del issue #2 — kal-in vendorizado y conectado a mano). Los
# disable explícitos de acá abajo no son solo prolijidad: chroot/ se
# conserva entre builds a propósito, y systemd no borra symlinks de
# [Install] viejos solos — sin esto, un servicio que estuvo habilitado
# en una corrida anterior (kal-backend.service viejo, o
# likay-smoke-test.service de antes de tener kal-in) sigue arrancando
# igual y compite por el :8000. Ya nos pasó en vivo una vez con
# kal-backend.service (ModuleNotFoundError de agent_core en cada boot
# pese al disable — resultó ser un Wants= en likay-kiosk.service, ya
# arreglado, pero el disable acá sigue siendo la red de seguridad
# correcta contra symlinks viejos).
systemctl disable kal-backend.service 2>/dev/null || true
systemctl disable likay-smoke-test.service 2>/dev/null || true
systemctl enable kal-in-backend.service
systemctl enable likay-kiosk.service
