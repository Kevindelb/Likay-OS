#!/bin/bash
set -euo pipefail

# Probado en QEMU (2026-09-14): con Xorg + pkexec ya funcionando,
# Calamares fallaba al arrancar (CalamaresApplication::initFailed)
# porque settings.conf (vendorizado de calamares-settings-debian)
# referencia seis módulos custom de Debian que no venían instalados.
# Investigado más a fondo (mismo día): los seis son módulos tipo
# "process" -- scripts de shell, NO binarios compilados como se asumió
# al principio (ver vendor/calamares-settings-debian/calamares-modules/
# */module.desc, campo interface: "process"). Tres de ellos
# (dpkg-unsafe-io, dpkg-unsafe-io-undo, bootloader-config, adaptado) ya
# se restauraron de verdad -- ver
# config/includes.chroot/usr/lib/x86_64-linux-gnu/calamares/modules/ y
# config/includes.chroot/usr/share/calamares/helpers/.
#
# Los tres que quedan afuera acá SÍ son genuinamente incompatibles, no
# solo "no compilados": están hardcodeados a rutas de montaje de
# live-build/live-boot (/run/live/medium, /run/initramfs/live) que no
# existen en nuestro medio live basado en casper (el nuestro monta en
# /cdrom), y a RELEASE="trixie" + los servidores de paquetes de Debian
# (deb.debian.org) -- nosotros somos Ubuntu resolute (ver
# iso/auto/config, --distribution resolute), no Debian. Restaurarlos
# tal cual rompería el apt del sistema instalado, no solo sería
# cosmético. Necesitan una versión propia de Likay-OS (que sepa de
# casper y apunte a los repos de Ubuntu) -- todavía no escrita, ver
# docs/ROADMAP.md, Etapa 2.
SEQUENCE_INCOMPATIBLE_MODULES=(
    sources-media
    sources-media-unmount
    sources-final
)
SETTINGS=/etc/calamares/settings.conf

if ! [ -f "${SETTINGS}" ]; then
    echo "0430: no existe ${SETTINGS} -- ¿corrió el rsync de vendor/calamares-settings-debian en auto/build?" >&2
    exit 1
fi

python3 - "${SETTINGS}" "${SEQUENCE_INCOMPATIBLE_MODULES[@]}" <<'PYEOF'
import sys

path = sys.argv[1]
missing_modules = sys.argv[2:]

with open(path) as f:
    content = f.read()

removed = []
for name in missing_modules:
    line = f"  - {name}\n"
    if line in content:
        content = content.replace(line, "", 1)
        removed.append(name)

if removed:
    with open(path, "w") as f:
        f.write(content)
    print(f"0430: sacados de la secuencia (rutas/repos de Debian live-build, no aplican a casper/Ubuntu): {', '.join(removed)}")
else:
    print("0430: ningún módulo de la lista estaba en settings.conf (build anterior ya parcheado, o cambió el vendorizado) -- nada que hacer.")
PYEOF
